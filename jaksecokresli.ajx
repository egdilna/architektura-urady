    },
    {
      "id": "metamodelpotreba",
      "layer": "motivation",
      "type": "Driver",
      "stereotype": "Potřeba",
      "name": "Potřeba nebo důvod motivace",
      "určuje": "",
      "příznaky": "metamodel",
      "description": "Pojmenovaný důvod nebo potřeba, na základě které jsme motivováni k přípravě a realizaci něčeho. Kupříkladu potřeba je motivací pro nějaký projekt nebo pro nějaký vnitřní předpis."
    },
    {
      "id": "metamodelpozadavek",
      "layer": "motivation",
      "type": "Requirement",
      "stereotype": "Požadavek",
      "name": "Požadavek",
      "určuje": "",
      "příznaky": "metamodel",
      "description": "Požadavek se zakresluje na motivační vrstvě a ve veřejné správě má více významů. Je to něco, co někdo požaduje a někdo to má zajistit. Může se jednat o vnitřní požadavek, ale také o požadavek v souvislosti s veřejnými zakázkami."
    },
    {
      "id": "metamodelprincip",
      "layer": "motivation",
      "type": "Principle",
      "stereotype": "Architektonický princip",
      "name": "Architektonický princip",
      "určuje": "",
