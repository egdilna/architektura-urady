      "description": "Aplikační služba pro alespoň rámcový rozpis toho, co dělá aplikace či systém."
    },
    {
      "id": "metamodelkomponentais",
      "layer": "application",
      "type": "ApplicationComponent",
      "stereotype": "Komponenta IS",
      "name": "Komponenta systému",
      "určuje": "",
      "příznaky": "metamodel",
      "description": "Fyzická komponenta systému, se kterou se na vývojové větvi pracuje či dá pracovat samostatně. Může se jednat o fyzické komponenty i s různými dodavateli, což je dobrý způsob oddělení komponent v architektuře."
    },
    {
      "id": "metamodelplatformnisw",
      "layer": "application",
      "type": "ApplicationComponent",
      "stereotype": "Platformní software",
