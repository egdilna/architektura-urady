    {
      "id": "isvsmetamodelsoubudaju",
      "sourceId": "isvs",
      "targetId": "metamodelsoubudaju",
      "type": "Access",
      "name": "je evidencí pro",
      "description": "subjekt z pohledu jeho zdroje musí mít také nějaký zdrojový informační systém, ve kterém je definován a ze kterého vychází jeho referenční identita. Proto v některých případech zakreslujeme, že subjekt jako aktér je evidován v informačním systému veřejné správy, tedy že informační systém veřejné správy je evidencí pro daný subjekt.",
      "příznaky": "metamodel"
    },
    {
      "id": "isvsmetamodelproces",
      "sourceId": "isvs",
      "targetId": "metamodelproces",
      "type": "Serving",
      "name": "podporuje proces",
      "description": "Proces se řeší v daném IS se zanáší vazbou ze systému do procesu, říká to, že systém podporuje proces. Podobné vazby jsou mezi aplikační a byznysovou vrstvou obvyklé.",
      "příznaky": "metamodel"
    },
    {
      "id": "metamodelkomponentaismetamodelproces",
      "sourceId": "metamodelkomponentais",
      "targetId": "metamodelproces",
      "type": "Serving",
      "name": "podporuje",
      "description": "Proces se řeší v daném IS a to konkrétně v jedné jeho komponentě (z uživatelského pohledu) se zanáší vazbou ze komponenty do procesu, říká to, že daná část systému podporuje něco byznysového. Podobné vazby jsou mezi aplikační a byznysovou vrstvou obvyklé.",
      "příznaky": "metamodel"
    },
    {
      "id": "metamodelkomponentaismetamodelrcinnost",
