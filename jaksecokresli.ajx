  "elements": [
    {
      "id": "metamodelschopnost",
      "layer": "strategy",
      "type": "Capability",
      "stereotype": "Schopnost",
      "name": "Schopnost",
      "určuje": "",
      "příznaky": "metamodel",
      "description": "Komplexní schopnost, zejména u schopností úřadu. Znamená společnou schopnost v úřadě, která se vykonává jednotně napříč celým úřadem a má i jednotné metodiky a jednotný rámec, ať už se dotýká jakékoliv agendy (v agendách může být pochopitelně parametricky přizpůsobena). Schopnost lze na byznysové vrstvě nejlépe rozpadnout na elementy typu [Služba] a [Proces], důležité jsou také [Role] zejména uvnitř úřadu. Na aplikační vrstvě se nesmí zapomínat zejména na [Informační systém veřejné správy] a [Informační systém], díky kterým můžeme schopnost realizovat. Schopnost plyne z nějakého byznysového prvku, a tedy zejména z typů [Povinnost]."
    },
    {
      "id": "ikcr",
      "layer": "business",
      "type": "Contract",
      "stereotype": "Závazný předpis",
      "name": "Informační koncepce ČR",
      "určuje": "§ 5a odst. 1 zákona 365/2000 a UV 931 z 9.11.2022",
      "příznaky": "metamodel",
      "description": "Informační koncepce ČR je závazným koncepčním dokumentem stanovujícím principy a zásady a cíle pro rozvoj veřejné správy a eGovernmentu. OVM a OVS se podle ní musejí řídit, stanoví to § 5 a § 5a, zákona 365/2000. / https://archi.gov.cz/ikcr-dokument:ikcr"
    },
    {
      "id": "metamodelagenda",
      "layer": "business",
      "type": "BusinessFunction",
      "stereotype": "Agenda",
      "name": "Agenda veřejné správy",
      "určuje": "ohlášení v RPP",
      "příznaky": "metamodel",
      "description": "Agenda podle zákona 111/2009. agendou se rozumí ucelená oblast působení orgánu veřejné moci nebo ucelená oblast působení"
    },
    {
      "id": "metamodelbyzstrategie",
      "layer": "business",
      "type": "Contract",
      "stereotype": "Vnitřní předpis",
      "name": "Strategie organizace",
      "určuje": "",
      "příznaky": "metamodel",
      "description": "Základní závazný vnitřní dokument organizace určující její obecné strategické směřování a podrobnosti k jejímu fungování a stanovující strategické cíle a jejich realizaci."
    },
    {
      "id": "metamodelikovs",
      "layer": "business",
      "type": "Contract",
      "stereotype": "Vnitřní předpis",
      "name": "Informační koncepce úřadu",
      "určuje": "§ 5a odst. 2 zákona 365/2000",
      "příznaky": "metamodel",
      "description": "Informační koncepce zpracovaná podle zákona o ISVS a vyhlášky o dlouhodobém řízení je jediným legálním závazným koncepčním rámcem úřadu."
    },
    {
      "id": "metamodelitstrategie",
      "layer": "business",
      "type": "Contract",
      "stereotype": "Vnitřní předpis",
      "name": "Strategie rozvoje IT",
      "určuje": "",
      "příznaky": "metamodel",
      "description": "Základní závazný vnitřní dokument s koncepčním strategickým rámcem pro fungování a rozvoj ICT a aplikací a systémů v organizaci. Mimo jiné, zhodnocuje aktuální stav a jeho problémy, definuje cíle rozvoje IT a principy a zásady pro správu a rozvoj ICT v organizaci a určuje podmínky k jejich realizaci. Zatímco úřad si povinně zpracovává jako tento dokument Informační koncepci, toto je dobrovolný, ale nezbytný dokument jiné organizace, jež není úřadem."
    },
    {
      "id": "metamodelorganizace",
      "layer": "business",
      "type": "BusinessActor",
      "stereotype": "Organizace",
      "name": "Organizace",
      "určuje": "",
      "příznaky": "metamodel",
      "description": "Organizace jako aktér v rámci architektury"
    },
    {
      "id": "metamodelposkytovanasluzba",
      "layer": "business",
      "type": "BusinessService",
      "stereotype": "Poskytovaná služba",
      "name": "Poskytovaná služba",
      "určuje": "",
      "příznaky": "metamodel",
      "description": "Byznysová služba poskytovaná někým pro někoho, ať už jde o konkrétní poskytnutí jednomu příjemci, nebo o komplexní službu. Její specializací jsou pak služby veřejné správy, jež OVM poskytují uživatelům. Služba je to na byznysové úrovni."
    },
    {
      "id": "metamodelpovinnost",
      "layer": "business",
      "type": "BusinessObject",
      "stereotype": "",
      "name": "Povinnost",
      "určuje": "",
      "příznaky": "",
      "description": "Povinnost definovaná právním předpisem, je ve skutečnosti základem kontraktu zúčastněných stran, přičemž pro stranu poskytovatele povinnosti je povinnou."
    },
    {
      "id": "metamodelproces",
      "layer": "business",
      "type": "BusinessProcess",
      "stereotype": "Vnitřní proces",
      "name": "Proces",
      "určuje": "",
      "příznaky": "metamodel",
      "description": "Identifikovaný a popsaný proces"
    },
    {
      "id": "metamodelramcovasluzba",
      "layer": "business",
      "type": "BusinessService",
      "stereotype": "Rámcová služba",
      "name": "Rámcová služba",
      "určuje": "",
      "příznaky": "metamodel",
      "description": "Jedná se o byznysovou službu, která je rámcová ve smyslu, že díky ní se pak poskytují konkrétní služby."
    },
    {
      "id": "metamodelrole",
      "layer": "business",
      "type": "BusinessRole",
      "stereotype": "",
      "name": "Role",
      "určuje": "",
      "příznaky": "",
      "description": "Určitá byznysová role. Jsme vždy schopni k dané roli přiřadit někoho a role vykonává činnosti či pracuje s dalšími objekty. I role je klíčovým elementem v modelu architektury EG."
    },
    {
      "id": "metamodelsluzbavs",
      "layer": "business",
      "type": "BusinessService",
      "stereotype": "",
      "name": "Služba veřejné správy",
      "určuje": "",
      "příznaky": "",
      "description": "Služba veřejné správy buď formálně zavedená do Katalogu služeb, nebo jde o obecnou, i když nezapsanou službu, jež poskytuje OVM či veřejnoprávní subjekt jejím uživatelům. Specializací je pak digitální služba podle zákona 12/2020."
    },
    {
      "id": "metamodelutvar",
      "layer": "business",
      "type": "BusinessActor",
      "stereotype": "Útvar",
      "name": "Organizační útvar",
      "určuje": "",
      "příznaky": "metamodel",
      "description": "Organizační jednotka jako útvar definovaný v rámci struktury (v organizačním řádu)"
    },
    {
      "id": "metamodelvnitrnipredpis",
      "layer": "business",
      "type": "Contract",
      "stereotype": "",
      "name": "Závazný předpis",
      "určuje": "",
      "příznaky": "",
      "description": "Vydaný předpis s určitou platností, vydává jej vždy někdo na základě něčeho a může být prováděním jiného předpisu. Je do určité míry závazný, většinou pro organizaci vydavatele."
    },
    {
      "id": "metamodelvnitrnirole",
      "layer": "business",
      "type": "BusinessRole",
      "stereotype": "",
      "name": "Role osoby nebo útvaru v organizaci",
      "určuje": "",
      "příznaky": "",
      "description": "Osoba či útvar nebo organizační jednotka má jednu či více rolí. Vnitřní rolí se rozumí role vykonávající určité procesy, nebo je zodpovědná za určitou oblast nebo činnosti. Jednotlivé vazby se pak vazbí právě na tuto roli, nikoliv na konkrétní útvar."
    },
    {
      "id": "metamodelvyhlaska",
      "layer": "business",
      "type": "Contract",
      "stereotype": "Právní předpis",
      "name": "Vyhláška",
      "určuje": "",
      "příznaky": "metamodel",
      "description": "Jedna vyhláška nebo nařízení vlády, je prováděcím předpisem zákona (většinou) a lze ji najít také ve sbírce."
    },
    {
      "id": "metamodelzakon",
