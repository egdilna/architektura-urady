    <element xsi:type="archimate:Goal" name="Specifický cíl 2.5 Fungující infrastruktura a služby pro výměnu dat ve veřejné správě" id="stratsprdco250" profiles="id-938b3962368b4aceaf3f601aeb264c5f">
      <documentation>Současná infrastruktura Informačního systému sdílené služby byla navržena a realizována již před více než pěti lety. Pro zajištění její funkčnosti s nabývajícím objemem vyřizovaných požadavků je nutné posílení stávající technické infrastruktury v rámci existující architektury a doplnění architektury pro splnění požadavků, které vznikly v posledních letech,</documentation>
      <property key="Stereotype" value="Objekt strategie"/>
      <property key="Určuje" value="Strategie správy dat VS"/>
      <property key="Packages" value="strategiespravydatcr"/>
      <property key="FQname" value="Objekt strategie Specifický cíl 2.5 Fungující infrastruktura a služby pro výměnu dat ve veřejné správě"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:Goal" name="Opatření 2.5.1 Zajistit spolehlivé fungování služeb ISSS" id="stratsprdco251" profiles="id-938b3962368b4aceaf3f601aeb264c5f">
