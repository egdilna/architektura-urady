    <element xsi:type="archimate:Goal" name="Opatření 2.5.2 Implementovat služby ISSS umožňující efektivní dávkovou výměnu dat" id="stratsprdco252" profiles="id-938b3962368b4aceaf3f601aeb264c5f">
