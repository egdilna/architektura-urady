      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Architektonický princip Architektonický princip"/>
      <property key="Status" value="metatemplate"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:Principle" name="Zásada řízení" id="metamodelzasada" profiles="id-06f9bd805fd141d491a4235a6f32aefe">
      <documentation>Definovaná zásada uplatňovaná při řízení rozvoje ICT, je závazná pro jakýkoliv aspekt rozvoje ICT, jehož se týká. Je povinně dodržována.</documentation>
