        <property key="Určuje" value="IKČR"/>
      </element>
      <element xsi:type="archimate:Principle" name="Zásada řízení ICT Z13: Nezávislost návrhu, řízení a kontroly kvality" id="ikcrZ13" profiles="id-15658d97819f4ababa6b3e9048070d4c">
        <documentation>Projekt musí být řízen dle standardní projektové metodiky interním PM s dostatečnou alokovanou kapacitou a kvalifikací po celou dobu návrhu, implementace a předávání ISVS do provozu, nebo externím PM (z kompetenčního centra). Pouze v případě nedostupnosti interních zdrojů a zdrojů kompetenčního centra je možné zadat PM roli externímu subjektu soutěží. Vybraný uchazeč nesmí mít vztah s dodavatelem ani provozovatelem.</documentation>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="User notes"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="Určuje" value="IKČR"/>
