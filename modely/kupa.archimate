      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:Goal" name="Opatření 3.1.2 Využívat při digitalizaci služeb možnost získání dat od jiných úřadů" id="stratsprdco312" profiles="id-938b3962368b4aceaf3f601aeb264c5f">
