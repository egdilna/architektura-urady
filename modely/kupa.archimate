    </element>
    <element xsi:type="archimate:Goal" name="Opatření 1.4.2 Zohledňovat při zadávání a řešení změn IS dopady na data a jejich správu" id="stratsprdco142" profiles="id-938b3962368b4aceaf3f601aeb264c5f">
