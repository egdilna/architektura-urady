    <element xsi:type="archimate:CompositionRelationship" name="obsahuje" id="groupingikcrovmitcilegroupingikcrcile" profiles="id-39c52d83ede04a5694909a5f5b01a076" source="groupingikcrovmitcile" target="groupingikcrcile">
      <documentation>Pro stanovení cílů v IK OVS platí, že je vhodné adoptovat maximální možný rozsah cílů z IKČR. Není zde povinnost adoptovat všechny cíle, ale i pro budoucí projekty se pak hodí do jejich motivace uvádět cíle z IKČR.</documentation>
      <property key="Factoring" value="Strategie a řízení"/>
      <property key="FQname" value="Skupina Cíle rozvoje ITúřadu￼ obsahuje Skupina Národní cíle IKČR ￼"/>
      <property key="Statement" value="Cíle rozvoje ITúřadu￼ obsahuje Národní cíle IKČR ￼"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
      <property key="In diagrams" value="prehledikovsadopceikcr"/>
      <property key="Packages"/>
    </element>
    <element xsi:type="archimate:CompositionRelationship" name="obsahuje" id="groupingikcrovmitcileitciladopcepzikcr" profiles="id-39c52d83ede04a5694909a5f5b01a076" source="groupingikcrovmitcile" target="itciladopcepzikcr">
      <documentation>Kromě adoptovaných cílů z IKČR si stanovujeme i svoje, toto je kupříkladu vhodný cíl, který bychom si měli osvojit za vlastní.</documentation>
      <property key="Factoring" value="Strategie a řízení"/>
      <property key="FQname" value="Skupina Cíle rozvoje ITúřadu￼ obsahuje Cíl rozvoje Řádná adopce architektonických principů a zásad řízení z Informační koncepce Čr"/>
      <property key="Statement" value="Cíle rozvoje ITúřadu￼ obsahuje Řádná adopce architektonických principů a zásad řízení z Informační koncepce Čr"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
      <property key="In diagrams" value="prehledikovsadopceikcr"/>
      <property key="Packages"/>
    </element>
    <element xsi:type="archimate:CompositionRelationship" name="obsahuje" id="groupingikcrovmitcileitcilnasecilecileikcr" profiles="id-39c52d83ede04a5694909a5f5b01a076" source="groupingikcrovmitcile" target="itcilnasecilecileikcr">
      <documentation>Další příklad vlastního cíle v úřadu, tento cíl je vhodný pro správnou realizaci projektů.</documentation>
      <property key="Factoring" value="Strategie a řízení"/>
      <property key="FQname" value="Skupina Cíle rozvoje ITúřadu￼ obsahuje Cíl rozvoje Stanovení cílů a realizace projektů pro naplnění národních cílů z IKČR￼"/>
