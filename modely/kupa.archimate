        <property key="Určuje"/>
        <property key="Packages" value="egl0klicovalegislativa"/>
        <property key="FQname" value="Právní předpis Směrnice EU 2019/882 EAA"/>
        <property key="Status" value="Updated"/>
        <property key="User notes"/>
      </element>
      <element xsi:type="archimate:Contract" name="Nařízení EU 910/2014 EIDAS" id="legislativaeidas" profiles="id-17b8e3539df84e1fb3b4b9557612848b">
        <documentation>Nařízení EU č. 910/2014 ze dne 23. července 2014 o elektronické identifikaci a službách vytvářejících důvěru pro elektronické transakce na vnitřním trhu / https://eur-lex.europa.eu/legal-content/CS/TXT/HTML/?uri=CELEX%3A32014R0910&amp;from=CS#d1e1759-73-1</documentation>
