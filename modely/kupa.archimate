    <element xsi:type="archimate:Goal" name="Specifický cíl 2.3 Vzdělávání a zprostředkování výměny zkušeností v oblasti práce s daty" id="stratsprdco230" profiles="id-938b3962368b4aceaf3f601aeb264c5f">
      <documentation>Pro podporu kvalitní správy dat zajistí DIA školení, odborný rozvoj a osvětu v této oblasti, a to s využitím nejen vlastních kapacit, ale i s významným zapojením samotných úřadů ochotných sdílet vlastní zkušenosti, akademické sféry a dalších spolupracujících externích subjektů.</documentation>
      <property key="Stereotype" value="Objekt strategie"/>
      <property key="Určuje" value="Strategie správy dat VS"/>
      <property key="Packages" value="strategiespravydatcr"/>
      <property key="FQname" value="Objekt strategie Specifický cíl 2.3 Vzdělávání a zprostředkování výměny zkušeností v oblasti práce s daty"/>
