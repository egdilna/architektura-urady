    </element>
    <element xsi:type="archimate:BusinessRole" name="Věcný gestor agendy či oblasti" id="vrvecnygestor" profiles="id-4ffa1235603f4aab9d06979a6a17aa08">
      <documentation>Organizační součást, útvar, nebo osoba, jež je v instituci zodpovědná za výkon činností v dané agendě či oblasti. Zodpovídá za řídící, metodickou a konzultační roli a je věcným správcem příslušných informačních systémů nebo jejich komponent a editorem souvisejících údajů, nebo vykonává dohled nad ostatními editory. Z pohledu ISVS je to jeho věcný správce. Také zodpovídá za legislativní rámec a jeho kvalitu a vykonává činnosti periodické kontroly efektivity.</documentation>
      <property key="Stereotype" value="Vnitřní role"/>
      <property key="Určuje"/>
      <property key="Packages" value="duleziterolevuradu, vykondulezitychcinnosti"/>
      <property key="FQname" value="Vnitřní role Věcný gestor agendy či oblasti"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Věcný správce informačního systému" id="vrvecnyspravceis" profiles="id-4ffa1235603f4aab9d06979a6a17aa08">
      <documentation>Útvar, jež je věcným gestorem za agendy a oblasti pro daný systém, tedy je odborným garantem funkcí a kvality systému a spravovaných údajů a činností ostatních editorů.</documentation>
      <property key="Stereotype" value="Vnitřní role"/>
      <property key="Určuje"/>
      <property key="Packages" value="duleziterolevuradu, vykondulezitychcinnosti"/>
      <property key="FQname" value="Vnitřní role Věcný správce informačního systému"/>
      <property key="Status" value="Updated"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Vedoucí projektu rozvoje IS" id="vrvedprojis" profiles="id-4ffa1235603f4aab9d06979a6a17aa08">
      <property key="Stereotype" value="Vnitřní role"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti"/>
      <property key="FQname" value="Vnitřní role Vedoucí projektu rozvoje IS"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Zpracovatel osobních údajů" id="zpracgdpr" profiles="id-de8963c4effe47a4b9e4d0b63f713fc7">
      <documentation>Subjekt, jež je zpracovatelem podle GDPR a zákona 110/2019 o zpracování osobních údajů</documentation>
      <property key="Stereotype" value="Role organizace"/>
      <property key="Určuje" value="GDPR, zákon 110/2019"/>
      <property key="Packages"/>
      <property key="FQname" value="Role organizace Zpracovatel osobních údajů"/>
      <property key="Status" value="New"/>
      <property key="User notes"/>
    </element>
  </folder>
  <folder name="Application" id="id-f2d89a3f731c40009d870040e8f3fa42" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="ABOK ČNB" id="abok" profiles="id-38361775da8344ccb7fe87fb59347b66">
      <documentation>ABOK je informační systém pro bankovnictví u státních účtů vedených u ČNB</documentation>
      <property key="Stereotype" value="ISVS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="ISVS ABOK ČNB"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Centrální autentizační informační systém" id="cais" profiles="id-38361775da8344ccb7fe87fb59347b66">
      <documentation>Informační systém nahrazující JIP a JIP/KAAS pro služby autentizace k informačním systémům veřejné správy jiných správců</documentation>
      <property key="Stereotype" value="ISVS"/>
      <property key="Určuje" value="§ 56a zákona 111/2009"/>
      <property key="Packages"/>
      <property key="FQname" value="ISVS Centrální autentizační informační systém"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:DataObject" name="Data vzniklá spojením nebo agregací více zdrojů" id="dataagregovana" profiles="id-3cfb04776fda429d9ffba3d95c59b137">
      <documentation>Data určená pro publikaci, a to jako otevřená či dynamická data, pocházejí z více zdrojů, a to buď spojením více datových zdrojů z více systémů, nebo agregací z více zdrojů.</documentation>
      <property key="Stereotype" value="Soubor údajů"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Soubor údajů Data vzniklá spojením nebo agregací více zdrojů"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:DataObject" name="Data neevidovaná v žádném AIS" id="dataneaispub" profiles="id-3cfb04776fda429d9ffba3d95c59b137">
      <documentation>Data určená pro přístup veřejnosti, a tedy určená pro publikaci jako opendata, ale nejsou evidovaná v žádném AIS, je tedy nutno je někde vytvořit a spravovat pro jejich publikaci.</documentation>
      <property key="Stereotype" value="Soubor údajů"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Soubor údajů Data neevidovaná v žádném AIS"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:DataObject" name="Data úřední desky" id="dataudeskapub" profiles="id-3cfb04776fda429d9ffba3d95c59b137">
      <documentation>Elektronická úřední deska s metadaty o zveřejňovaných dokumentech a s odkazy na zveřejňované dokumenty. I taková data je nutno z úřední desky publikovat.</documentation>
      <property key="Stereotype" value="Soubor údajů"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Soubor údajů Data úřední desky"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:DataObject" name="Data evidovaná v AIS" id="davaaispub" profiles="id-3cfb04776fda429d9ffba3d95c59b137">
      <documentation>Data, jež jsou spravována a evidována v nějakém AIS. Jsou ohlášena v RPP a nejsou označena za nepřístupná veřejnosti. Data lze tedy z AIS vzít a publikovat je, nebo je publikovat po nějakém zpracování.</documentation>
      <property key="Stereotype" value="Soubor údajů"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Soubor údajů Data evidovaná v AIS"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Informační systém sdílené služby (eGSB)" id="egsb" profiles="id-38361775da8344ccb7fe87fb59347b66">
      <documentation>eGON Service Bus je rozhraním pro realizaci propojeného datového fondu.</documentation>
      <property key="Stereotype" value="ISVS"/>
      <property key="Určuje" value="§ 2 písm g) zákona 111/2009"/>
      <property key="Packages" value="zrapp"/>
      <property key="FQname" value="ISVS Informační systém sdílené služby (eGSB)"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Informační systém výdeje údajů (FAIS)" id="fais" profiles="id-16fd9edf3ded4571a002ad9cc6122219">
      <documentation>FAIS je součástí referenčního rozhraní. Jedná se o formulářově řízený výdej údajů z PPDF podle bezpečnostního oprávnění. K tomu slouží formální část FAIS. Správcem je SZR.</documentation>
      <property key="Stereotype" value="ISVS"/>
      <property key="Určuje" value="§ 2 písm h) zákona 111/2009"/>
      <property key="Packages"/>
      <property key="FQname" value="ISVS Informační systém výdeje údajů (FAIS)"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Informační systém datových schránek" id="isds" profiles="id-38361775da8344ccb7fe87fb59347b66">
      <documentation>ISDS je informačním systémem veřejné správy podle zákona 300/2008 spravujícím a zajišžujícím fungování datových schránek a přenos datových zpráv. Správcem ISDS je Digitální a informační agentura.</documentation>
      <property key="Stereotype" value="ISVS"/>
      <property key="Určuje" value="§ 14 zákona 300/2008"/>
      <property key="Packages"/>
      <property key="FQname" value="ISVS Informační systém datových schránek"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Správa dokumentace datové sady" id="isodasdoksprav" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Modul umožňuje buď automaticky sestavit dokumentaci k datové sadě, nebo spravovat a ukládat a poskytovat do úložiště dokumentaci vytvořenou mimo systém a to jak ve formátu PDF, tak ve formátu obsahu webové stránky pro Lokální katalog či pro záznam v NKOD.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Správa dokumentace datové sady"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Sestavení dokumentace ze schématu JSON" id="isodasdsdoksestav" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Modul umožňuje podle připraveného JSONB-scheme vytvořit jednoduchou dokumentaci ke struktuře datové sady, která se pak publikuje jako součást metadat o datové sadě. Vytvoření lze kdykoliv znovu vyvolat, aby bylo možno aktualizovat dokumentaci podle aktualizovaného schématu JSON, které zadá správce prvotních dat nebo správce katalogu či jiný administrátor modulu.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Sestavení dokumentace ze schématu JSON"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Přehled statistiky datové sady" id="isodasdsstat" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Modul umožňuje správci katalogu a správci datové sady (správce primárních dat) zobrazit statistiku o datové sadě, včetně počtu záznamů, pravidelnosti aktualizací, přírůstků mezi jednotlivými aktualizacemi, apod.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Přehled statistiky datové sady"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Přehled statistiky stažení datové sady" id="isodasdsstatdown" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Úložiště službou zapisuje počty stažení souboru datové sady, modul pak zobrazuje v rámci statistiky datové sady počty stažení celkem a počty stažení jednotlivých aktualizací a počty za určitá období (měsíc a rok).</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Přehled statistiky stažení datové sady"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Evidence způsobu získání datové sady" id="isodasevidjakziskat" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>V modulu se pro účely evidence i dokumentace, ale i pro faktickou integraci, eviduje jak se získává samotná datová sada a co se k tomu integruje a jak</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Evidence způsobu získání datové sady"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Kontrola datové sady proti schématu OFN" id="isodaskontroladsofn" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Modul umožňuje u datových schémat s vyhlášeným závazným schématem v otevřené formální normě, kontrolu JSON datové sady na soulad s tímto schématem.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Kontrola datové sady proti schématu OFN"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Kontrola datové sady proti dokumentačnímu schématu" id="isodaskontroladsschema" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Modul umožňuje jednoduchou kontrolu JSON souboru proti dokumentačnímu publikačnímu schématu JSON, které je součástí dokumentace datové sady. Sleduje se validace oproti schématu a jeho prvkům.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Kontrola datové sady proti dokumentačnímu schématu"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Přehledy o datech a datových sadách" id="isodasmanprehledy" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Modul poskytuje základní statistické a přehledové sestavy o připravovaných a publikovaných datových sadách s daty o aktualizaci určené pro management a administrátory.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Přehledy o datech a datových sadách"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Notifikace správce dat při chybách sestavení a agregace" id="isodasnotifchybagrsestav" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Modul umí zaslat e-mailovou notifikaci správci dat či technickému správci zdrojového informačního systému, pokud zdrojový systém neposkytne data, chová se neočekávaně nebo pokud selže sestavení datové sady z jiného důvodu.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Notifikace správce dat při chybách sestavení a agregace"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Sestavení dokumentu Publikačního plánu" id="isodaspubplangendok" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Modul umožňuje sestavit statický dokument publikačního plánu a jeho aktualizace pro projednání.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Sestavení dokumentu Publikačního plánu"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Tvorba a správa Publikačního plánu" id="isodaspubplantvor" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>V modulu se spravuje Publikační plán organizace a to jako soubor dat. V plánu jsou jak navrhovaná data, plánovaná data, tak i informace o publikovaných datech. Také se zapisují do Lokálního katalogu.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Tvorba a správa Publikačního plánu"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Správa podkladů pro vyhodnocení Publikačního plánu" id="isodaspubplanvyhodnpodkl" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Modul obsahuje základní funkce vyhodnocení plnění Publikačního plánu a to zejména přehled sad či skupin dat podle jejich stavu v Publikačním plánu. Takto lze také automaticky sestavovat podklady pro výroční zprávu.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Správa podkladů pro vyhodnocení Publikačního plánu"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Publikace statistik stažení jako otevřená data" id="isodaspubstat" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Modul sestavuje a publikuje počty stažení všech datových sad i za určitá období jako datovou sadu otevřených dat. Také sestaví příslušné podklady o statistikách pro výroční zprávu.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Publikace statistik stažení jako otevřená data"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Sestavení datové sady z více zdrojů" id="isodassestavdsagreg" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Je-li datová sada sestavována agregací či kompozicí dat z více zdrojů, tyto zdroje poskytnou data do modulu a ten sestaví datovou sadu a uloží jí do úložiště. Každé takové sestavení se musí zvlášť programovat a nastavit.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Sestavení datové sady z více zdrojů"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Správa záznamů o publikovaných datech a datových sadách " id="isodasspravzazndatsad" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Lokální katalog je systémem v němž se evidují a spravují oficiální údaje a metadata o všech publikovaných datových sadác a jejich dokumentace.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Správa záznamů o publikovaných datech a datových sadách "/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Zápis datové sady z připravených tabulkových dat do lokálního katalogu" id="isodastabdatadolk" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Modul umožňuje zápis údajů o datové sadě do lokálního katalogu a poskytuje přístup k souboru datové sady.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Zápis datové sady z připravených tabulkových dat do lokálního katalogu"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Tvorba datové sady z připravených tabulkových dat a předání do úložiště" id="isodastabdatadoul" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Modul po potvrzení uživatelem po editaci tabulky s tabulkovými daty vytvoří soubor či soubory datové sady ve formátech CSV a JSON a ty uloží do úložiště, dále záznam o cestě z úložiště přidá do dokumentace datové sady v lokálním katalogu.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Tvorba datové sady z připravených tabulkových dat a předání do úložiště"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Editace tabulkových dat pro publikaci" id="isodastabdataedit" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Modul obsahuje jednoduchý webový editor určený pro tvorbu a editaci tabulkových dat. Ten se využije pro data, která nejsou evidována v žádném jiném systému a která jsou také určena pro publikaci. Editor funguje jako klasický webový tabulkový editor se základními funkcemi.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Editace tabulkových dat pro publikaci"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Přístup k datům ostatními systémy" id="isodastabdatapristup" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Modul umožní na základě vlastních webových služeb přístup k tabulkám dat a to v režimu pro čtení či v režimu pro přidání nebo úpravu řádku. Tyto služby jsou jednoduché a mohou se využít ze strany ostatních systémů a aplikací pro případ, že by takto vytvořená tabulková data byla pro tyto systémy zajímavá a ty je chtěly využívat. Rozhodně to ale nenahrazuje sestavení datových sad ze zdrojových systémů.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Přístup k datům ostatními systémy"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Sestavení datových sad z připravených tabulkových dat" id="isodastabdatasestavds" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Z editované tabulky se sestaví datová sada a předá se do úložiště.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Sestavení datových sad z připravených tabulkových dat"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Sestavení schématu struktury datové sady a dokumentace" id="isodastabdatasestavschem" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Modul podle připravené datové sady jež se edituje jako tabulková data sestaví její datové schéma a připraví jednoduchou dokumentaci datové sady, kterou pak využijeme v lokálním katalogu či NKODu. Schéma se při změně struktury sloupců v tabulkových datech na vyžádání aktualizuje, sestaví se ze záhlaví sloupců tabulky.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Sestavení schématu struktury datové sady a dokumentace"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Vytvoření návrhu datové sady a zařazení do publikačního plánu" id="isodastvorbanavrh" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Kdokoliv s oprávněním může vytvořit návrh na publikování otevřených dat jako přípravu do Publikačního plánu, po jeho přijetí se postupně stane záznamem v Publikačním plánu a datovou sadou.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Vytvoření návrhu datové sady a zařazení do publikačního plánu"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Uživatelské rozhraní pro procházení informací o datových sadách a jejich hledání" id="isodasuilk" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Lokální katalog je zároveň webovým rozhraním pro anonymního uživateloe, v němž lze vyhledávat, zobrazovat a třídit záznamy o datových sadách a jejich dokumentace</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Uživatelské rozhraní pro procházení informací o datových sadách a jejich hledání"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Uchování historických verzí souboru datové sady" id="isodasulhistds" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Kromě aktuální verze souboru datové sady lze ukládat (tam, kde je to vhodné) i dřívější verze souborů datových sad (jejich historické verze). Ty mohou či nemusí být přístupné ke stažení.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Uchování historických verzí souboru datové sady"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Uložení souborů datové sady" id="isodasulozds" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Hlavní službou úložiště datových sad je pochopitelně ukládání a uchování souboru datové sady. Ať už je soubor vytvořen jakkoliv, úložiště umožní vložit soubor datové sady, samo úložiště je organizováno právě po oblastech a datových sadách a kromě samotného souboru se v něm ukládá i dokumentace a schémata (také jako soubory).</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Uložení souborů datové sady"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Zpřístupnění souboru datové sady přes URL ke stažení" id="isodasurlpod" profiles="id-7f1d0394667c442eaea9a42bc8e11610">
      <documentation>Lokální katalog nebo záznam NKOD odkazuje URL odkazem na soubory datové sady a soubory dokumentace k přímému stažení. To poskytuje úložiště.</documentation>
      <property key="Stereotype" value="Aplikační služba"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační služba Zpřístupnění souboru datové sady přes URL ke stažení"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Úložiště datových sad" id="ispubmodulstorageds" profiles="id-224b2ebf33464c059a5fedbc009ad128">
      <documentation>Úložiště pro uložení souborů připravených a publikovaných datových sad a některých základních metadat o souborech. Jde o úložiště výsledných souborů, do tohoto úložiště povedou adresy souborů datové sady. Úložiště slouží nejen pro veřejné poskytování otevřených dat, ale také pro potřeby publikujícího subjektu. V úložišti se nespravují jen aktuální verze datových sad, ale i historické aktualizace.</documentation>
      <property key="Stereotype" value="Komponenta IS"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Komponenta IS Úložiště datových sad"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="IS pro publikaci otevřených dat" id="ispubod" profiles="id-38361775da8344ccb7fe87fb59347b66">
      <documentation>Informační systém nebo ISVS, jež slouží pro podporu plnění povinností publikovat veškerá publikovatelná data jako otevřená data a dynamická data. Spravuje vždy publikující povinný subjekt.</documentation>
      <property key="Stereotype" value="ISVS"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="ISVS IS pro publikaci otevřených dat"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Uživatelské rozhraní pro procházení dat" id="ispubodui" profiles="id-224b2ebf33464c059a5fedbc009ad128">
      <documentation>Webové uživatelské rozhraní pro procházení, zobrazování, vyhledávání, filtraci a seskupování dat datových sad. Slouží jak správcům publikovaných dat, ale také může sloužit anonymním uživatelům dat prostřednictvím webového portálu publikátora. Je jednotným řešením pro zajištění prohledávatelnosti dat zveřejněných způsobem umožňujícím dálkový přístup.</documentation>
      <property key="Stereotype" value="Komponenta IS"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Komponenta IS Uživatelské rozhraní pro procházení dat"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="URI rozhraní publikovaných sad" id="ispuboduriinterface" profiles="id-547835d4b50d435c9016630052949d3e">
      <documentation>Rozhraní IS pro publikace opendat pro automatické vyzvedávání datových sad podle jejich identifikátorů a metadat a pro práci s datovými sadami a jejich soubory. Jde o vnitřní rozhraní, ale poskytující služby také pro externí integrace ven.</documentation>
      <property key="Stereotype" value="Aplikační rozhraní"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Aplikační rozhraní URI rozhraní publikovaných sad"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Registr smluv" id="isrs" profiles="id-38361775da8344ccb7fe87fb59347b66">
      <documentation>Informační systém Registr smluv slouží k uveřejňování smluv podle zákona 340/2015 a k přístupu k údajům o nich / správcem je DIA</documentation>
      <property key="Stereotype" value="ISVS"/>
      <property key="Určuje" value="§ 4 zákona 340/2015"/>
      <property key="Packages"/>
      <property key="FQname" value="ISVS Registr smluv"/>
      <property key="Status" value="New"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Informační systém základních registrů" id="iszr" profiles="id-38361775da8344ccb7fe87fb59347b66">
      <documentation>Informační systém referenčního rozhraní zprostředkující služby základních registrů a napojení AIS na registry</documentation>
      <property key="Stereotype" value="ISVS"/>
      <property key="Určuje" value="§ 2 písm g) zákona 111/2009"/>
      <property key="Packages" value="zrapp"/>
      <property key="FQname" value="ISVS Informační systém základních registrů"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Systém JIP" id="jip" profiles="id-224b2ebf33464c059a5fedbc009ad128">
      <documentation>Součást referenčního rozhraní a Registru práv a povinností podle zákona 111/2009 a zákona 365/2000 Jednotný identitní prostor úředníků, která umožňuje jednotné IDM zaměstnanců OVM v rolích pro autentizaci a autorizaci do role a do cizího AIS</documentation>
      <property key="Stereotype" value="Komponenta IS"/>
      <property key="Určuje" value="§ 56a zákona 111/2009"/>
      <property key="Packages"/>
      <property key="FQname" value="Komponenta IS Systém JIP"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Autentizační informační systém JIP/KAAS" id="jipais" profiles="id-38361775da8344ccb7fe87fb59347b66">
      <documentation>Informační systém sloužící jako část JIP/KAAS pro autentizaci a autorizaci zaměstnance OVM v jeho roli pro přístup do cizích AIS a ISVS</documentation>
      <property key="Stereotype" value="ISVS"/>
      <property key="Určuje" value="§ 56a zákona 111/2009"/>
      <property key="Packages"/>
      <property key="FQname" value="ISVS Autentizační informační systém JIP/KAAS"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Katalog služeb veřejné správy" id="ksvs" profiles="id-224b2ebf33464c059a5fedbc009ad128">
      <documentation>Část Registru práv a povinností a Portálu veřejné správy je evidencí ohlášených služeb veřejné služby v rámci agend a podrobností o jednotlivých službách. Editoři jsou ohlasovateié agend. Obsahuje i veřejnou publikovanou část s lidskými popisy služeb.</documentation>
      <property key="Stereotype" value="Komponenta IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Komponenta IS Katalog služeb veřejné správy"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Lokální katalog otevřených dat" id="lkod" profiles="id-224b2ebf33464c059a5fedbc009ad128">
      <documentation>Komponenta pro vedení a udržování lokálního katalogu otevřených dat, dynamických dat a jejich metadat. Mimo jiné sdílí informace do Národního katalogu otevřených dat (NKOD). A pokud má subjekt vlastní katalog otevřených dat, zajišťuje ho právě LKOD.</documentation>
      <property key="Stereotype" value="Komponenta IS"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Komponenta IS Lokální katalog otevřených dat"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Modul Kompozice dat" id="modulkompozdat" profiles="id-224b2ebf33464c059a5fedbc009ad128">
      <documentation>Modul umožňuje agregaci a přípravu dat a generování jednotlivých datových sad a metadat o nich, pokud to nezajišťuje sám publikující informační systém. Oprávněné osoby správců jednotlivých datových sad jej využívají jako administrační UI.</documentation>
      <property key="Stereotype" value="Komponenta IS"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Komponenta IS Modul Kompozice dat"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Modul Lokální katalog" id="modullokkat" profiles="id-224b2ebf33464c059a5fedbc009ad128">
      <documentation>Administrační UI modul pro správu záznamů v lokálním katalogu, editaci a správu metadat o jednotlivých datových sadách a službách. Slouží správcům LKOD a správcům jednotlivých datových sad pro jejich administrátorské úkony.</documentation>
      <property key="Stereotype" value="Komponenta IS"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Komponenta IS Modul Lokální katalog"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Modul Správa a publikace datových sad" id="modulpubadmdat" profiles="id-224b2ebf33464c059a5fedbc009ad128">
      <documentation>Administrátorský modul pro správce jednotlivých datových sad, kde vytvářejí jejich záznamy a skládají popis struktury datové sady a také provádějí kontrolu souladu se závaznými otevřenými formálními normami. Pomocí tohoto modulu také ukládají či přes rozhraní umožní ukládat datové sady do úložiště.</documentation>
      <property key="Stereotype" value="Komponenta IS"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Komponenta IS Modul Správa a publikace datových sad"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Modul Vytváření a příprava dat" id="modultvorbadat" profiles="id-224b2ebf33464c059a5fedbc009ad128">
      <documentation>Webový modul, který pro data neevidovaná v nějakém informačním systému umožní jejich přímé vytváření vizuální tvorbou jednoduchých datových struktur a editací záznamů, mimo jiné umí automaticky generovat z takových dat datové sady a jejich metadata a publikovat je přes LKOD do NKOD. Jde o webový editor pro data, která není možno rozumně spravovat jinak, ale musí být publikována.</documentation>
      <property key="Stereotype" value="Komponenta IS"/>
      <property key="Určuje"/>
      <property key="Packages" value="isodkompozice"/>
      <property key="FQname" value="Komponenta IS Modul Vytváření a příprava dat"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Národní bod EID (NIA)" id="nia" profiles="id-38361775da8344ccb7fe87fb59347b66">
      <documentation>Informační systém spravovaný DIA sloužící jako jediná legální cesta k propagaci a využívání elektronické identifikace orgány veřejné moci.</documentation>
      <property key="Stereotype" value="ISVS"/>
      <property key="Určuje" value="§ 20 zákona 250/2017"/>
      <property key="Packages"/>
      <property key="FQname" value="ISVS Národní bod EID (NIA)"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Národní katalog otevřených dat (NKOD)" id="nkod" profiles="id-38361775da8344ccb7fe87fb59347b66">
      <documentation>Národní katalog otevřených dat je ISVS spravovaný Ministerstvem vnitra ČR podle evropské legislativy a zákona 106/1999, kde jsou k dispozici a zveřejňovány informace a metadata jednotlivých datových sad otevřených dat.</documentation>
      <property key="Stereotype" value="ISVS"/>
      <property key="Určuje" value="§ 4c odst. 3 zákona 106/1999"/>
      <property key="Packages"/>
      <property key="FQname" value="ISVS Národní katalog otevřených dat (NKOD)"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Portál občana" id="pobc" profiles="id-224b2ebf33464c059a5fedbc009ad128">
      <documentation>Součást Portálu veřejné správy, kterou se přihlášeným uživatelům fyzickým osobám poskytují služby celé veřejné správy</documentation>
      <property key="Stereotype" value="Komponenta IS"/>
      <property key="Určuje" value="§ 6g zákona 365/2000 a související zákona 12/2020"/>
      <property key="Packages"/>
      <property key="FQname" value="Komponenta IS Portál občana"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Databáze publikujícího AIS" id="pubaisdatabaze" profiles="id-224b2ebf33464c059a5fedbc009ad128">
      <documentation>Databáze s údaji informačního systému, z nichž některé se publikují jako otevřená data či dynamická data.</documentation>
      <property key="Stereotype" value="Komponenta IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Komponenta IS Databáze publikujícího AIS"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Rozhraní datových služeb publikujícího AIS" id="pubaisrozhrani" profiles="id-547835d4b50d435c9016630052949d3e">
      <documentation>Aplikační volatelné rozhraní systému, jehož prostřednictvím se pro preprocesor a přípravu vyzvedávají data určená pro publikaci v datových sadách otevřených dat či dynamických dat. Je součástí zdrojového systému.</documentation>
      <property key="Stereotype" value="Aplikační rozhraní"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Aplikační rozhraní Rozhraní datových služeb publikujícího AIS"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Portál veřejné správy" id="pvs" profiles="id-38361775da8344ccb7fe87fb59347b66">
      <documentation>Informační systém veřejné správy jež spravuje DIA a je hlavním portálem služeb VS a OVM.</documentation>
      <property key="Stereotype" value="ISVS"/>
      <property key="Určuje" value="§ 6g zákona 365/2000"/>
      <property key="Packages"/>
      <property key="FQname" value="ISVS Portál veřejné správy"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Referenční rozhraní" id="referencnirozhrani" profiles="id-16fd9edf3ded4571a002ad9cc6122219">
      <documentation>Referenční rozhraní je logická soustava rozhraní pro vazby a integrace mezi informačními systémy veřejné správy. Referenční rozhraní spravuje Správa základních registrů a sestává z: [Informační systém základních registrů (ISZR)], [Informační systém sdílených služeb (eGSB)] a [Informační systém výdeje údajů (FAIS)]. Je povinností uskutečňovat vazby prostřednictvím referenčního rozhraní. Podrobnosti stanovuje [Zákon 365/2000 o ISVS] a zejména [vyhláška 53/2007 o referenčním rozhraní]</documentation>
      <property key="Stereotype" value="ISVS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="ISVS Referenční rozhraní"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Rejstřík Informačních systémů veřejné správy" id="risvs" profiles="id-38361775da8344ccb7fe87fb59347b66">
      <documentation>RISVS je součástí Registru práv a povinností. Slouźí k veřejné evidenci všech ISVS a údajích o nich a všech ISSPÚ a údajích o nich, za jednotlivé záznamy jsou zodpovědní vždy správci ISVS/ISSPÚ</documentation>
      <property key="Stereotype" value="ISVS"/>
      <property key="Určuje" value="§ 52c zákona 111/2009"/>
      <property key="Packages"/>
      <property key="FQname" value="ISVS Rejstřík Informačních systémů veřejné správy"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Registr obyvatel (ROB)" id="rob" profiles="id-38361775da8344ccb7fe87fb59347b66">
      <documentation>Základní registr fyzických osob</documentation>
      <property key="Stereotype" value="ISVS"/>
      <property key="Určuje"/>
      <property key="Packages" value="zrapp"/>
      <property key="FQname" value="ISVS Registr obyvatel (ROB)"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Registr osob (ROS)" id="ros" profiles="id-38361775da8344ccb7fe87fb59347b66">
      <documentation>Základní registr právnických osob a subjektů</documentation>
      <property key="Stereotype" value="ISVS"/>
      <property key="Určuje"/>
      <property key="Packages" value="zrapp"/>
      <property key="FQname" value="ISVS Registr osob (ROS)"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Rejstřík orgánů veřejné moci" id="rovm" profiles="id-224b2ebf33464c059a5fedbc009ad128">
      <documentation>Jde o součást Registru práv a povinností spravující údaje o orgánech veřejné moci ve vazbě na jejich působnost a jejich kategorie.</documentation>
      <property key="Stereotype" value="Komponenta IS"/>
      <property key="Určuje" value="§ 52b zákona 111/2009"/>
      <property key="Packages"/>
      <property key="FQname" value="Komponenta IS Rejstřík orgánů veřejné moci"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Registr práv a povinností (RPP)" id="rpp" profiles="id-38361775da8344ccb7fe87fb59347b66">
      <documentation>Základní registr sestávající ze dvou částí: Agendový model a působnost veřejné správy a zápis údajů o právech a povinnostech subjektů. RPP spravuje ministerstvo vnitra a obsahuje údaje o agendách a jejich podrobnosti a údaje o rozhodnutích zapsaných do RPP a údaje zápisů o právní skutečnosti.</documentation>
      <property key="Stereotype" value="ISVS"/>
      <property key="Určuje"/>
      <property key="Packages" value="zrapp"/>
      <property key="FQname" value="ISVS Registr práv a povinností (RPP)"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Registr územní identifikace adres a nemovitostí (RUIAN)" id="ruian" profiles="id-38361775da8344ccb7fe87fb59347b66">
      <documentation>Základní registr adres, územních prvků a územního členění</documentation>
      <property key="Stereotype" value="ISVS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="ISVS Registr územní identifikace adres a nemovitostí (RUIAN)"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Služby k datovému kmeni a subjektům" id="skupinasluzbydatovykmen" profiles="id-1e1a7ae0cf9a4e19b9e6e0deaf825558">
      <property key="Stereotype" value="Skupina"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Skupina Služby k datovému kmeni a subjektům"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Služby k propojenému datovému fondu a údajům" id="skupinasluzbyppdfudaje" profiles="id-1e1a7ae0cf9a4e19b9e6e0deaf825558">
      <property key="Stereotype" value="Skupina"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Skupina Služby k propojenému datovému fondu a údajům"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Aktualizace údajů o fyzické osobě z Registru obyvatel pro aktuální potřebu" id="typasaktualizacerobpotreba" profiles="id-5a96637beda94501b288c979796cd062">
      <documentation>Při aktuální potřebě lze aktualizovat jednorázově údaje o osobě ze základního registru. Činí se tak ale výhradně u subjektů, které nemáme zaregistrovány pro notifikace a u kterých neudržujeme aktuální datový fond přes AIFO i pro poskytování údajů.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Aktualizace údajů o fyzické osobě z Registru obyvatel pro aktuální potřebu"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Aktualizace údajů z Registru osob" id="typasaktualizaceros" profiles="id-5a96637beda94501b288c979796cd062">
      <documentation>Obdobně jako u fyzických osob z ROB se provádí aktualizace údajů o právnických subjektech z ROS. Identifikátorem je v tomto případě IČ a IČP.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Aktualizace údajů z Registru osob"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Aktualizace údajů z Registru osob a souvisejících údajů z Registru obyvatel" id="typasaktualizacerosrob" profiles="id-5a96637beda94501b288c979796cd062">
      <documentation>Pro zjištění údajů o jednatelích a osobách zastupujících právnický subjekt se nejprve provede zjištění těchto fyzických osob z ROS, ale následně se musí provést aktualizace údajů o fyzické osobě z Registru obyvatel, neboť ROS sám neposkytuje referenční údaje o fyzických osobách.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Aktualizace údajů z Registru osob a souvisejících údajů z Registru obyvatel"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Odhlášení Notifikace změny agendových údajů" id="typasodhlaseninotifudaje" profiles="id-5a96637beda94501b288c979796cd062">
      <documentation>Ve chvíli, kdy pomine potřeba úřadu pro jeho působnost využívat cizí agendový údaj, který má ohlášen pro notifikaci o změně, tuto notifikaci si odhlásí. Činí tak samozřejmě příslušnou službou propagovanou přes EGSB. Po odhlášení přestane publikující agendový informační systém zasílat Notifikace o změnách.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Odhlášení Notifikace změny agendových údajů"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Oznámení o ukončení evidování poskytovaného agendového údaje" id="typasoznukoncenievidudaje" profiles="id-5a96637beda94501b288c979796cd062">
      <documentation>Pokud poskytovatel agendového údaje přestane poskytovaný údaj ve své agendě evidovat, pochopitelně jej také přestane poskytovat dalším agendám. Tyto agendy tedy musí notifikovat a poskytnout jim oznámení o tom, že jimi využívaný agendový údaj již není dále evidován. Součástí takového oznámení by měl být i důvod, proč již údaj evidován není. Může pochopitelně vzniknout situace, kdy využívající agendy takový údaj potřebují nadále a nesouhlasí s ukončením jeho evidence u poskytovatele, v takovém případě se postupuje jako při každém jiném sporu o poskytování údajů mezi agendami.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Oznámení o ukončení evidování poskytovaného agendového údaje"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Přihlášení notifikace o změně agendových údajů z jiné agendy" id="typasprihlaseninotifikagudaj" profiles="id-5a96637beda94501b288c979796cd062">
      <documentation>V případě potřeby vždy aktuálních dat jako čtenářská agenda provedeme službami EGSB ohlášení, respektive, registraci notifikace pro změny údajů v publikujícím AISu. Identifikátorem je AIFO pro fyzické osoby a IČ pro právnické subjekty. Obdobné jako u registrace k notifikaci ze základních registrů.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Přihlášení notifikace o změně agendových údajů z jiné agendy"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Reklamace údajů o právnickém subjektu z Registru osob" id="typasreklamaceros" profiles="id-5a96637beda94501b288c979796cd062">
      <documentation>Vznikne-li oprávněná pochybnost o správnosti a platnosti údajů vedených o právnickém subjektu v Registru osob, vzneseme prostřednictvím ISZR a příslušného základního registru reklamaci vůči editoru údajů.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Reklamace údajů o právnickém subjektu z Registru osob"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Reklamace agendového údaje v jiném AIS" id="typasreklamaceudajejinam" profiles="id-5a96637beda94501b288c979796cd062">
      <documentation>V případě oprávněné pochybnosti o správnosti poskytovaného agendového údaje vzneseme jeho reklamaci prostřednictvím eGSB a publikujícího AISu vůči editoru údajů.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Reklamace agendového údaje v jiném AIS"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Reklamace údajů v zápisu o skutečnosti v RPP" id="typasreklamacezapisskutrpp" profiles="id-5a96637beda94501b288c979796cd062">
      <documentation>Vznikne-li oprávněná pochybnost o správnosti, platnosti a úplnosti údajů zapsaných do Registru osob na základě práva na zápis skutečnosti, vzneseme prostřednictvím ISZR reklamaci vůči Ministerstvu vnitra, které s příslušným orgánem veřejné moci tuto reklamaci vyřeší.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Reklamace údajů v zápisu o skutečnosti v RPP"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Vyžádání agendového údaje z jiného AIS" id="typasvyzadaniudajeodjinut" profiles="id-5a96637beda94501b288c979796cd062">
      <documentation>Při potřebě agendového údaje vedeného v jiné agendě pro splnění povinností nebo výkon působnosti si vyžádáme prostřednictvím eGSB od publikujícího AISu příslušné agendové údaje. Pozor, tímto způsobem nevyžadujeme referenční údaje vedené v základních registrech.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Vyžádání agendového údaje z jiného AIS"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Získání agendového údaje z jiného AIS" id="typasziskaniudajeodjinut" profiles="id-5a96637beda94501b288c979796cd062">
      <documentation>Pro splnění povinností nebo výkon působnosti prostřednictvím eGSB od publikujícího AISu získáme agendové údaje, a to v rozsahu a struktuře definované v ohlášené agendě.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Získání agendového údaje z jiného AIS"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Získání údajů Zápisu o skutečnosti z RPP" id="typasziskanizapisskutrpp" profiles="id-5a96637beda94501b288c979796cd062">
      <documentation>Na základě záznamu o odkazování klienta na zápis o skutečnosti si prostřednictvím ISZR vyžádáme a získáme příslušné údaje ze zápisu vedeného v RPP.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Získání údajů Zápisu o skutečnosti z RPP"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Zpracování registrace notifikace ke změnám agendových údajů do jiných agend" id="typaszpracnotifikregjinea" profiles="id-5a96637beda94501b288c979796cd062">
      <documentation>Po registraci čtenářského AIS k notifikacím subjektu zajistíme zasílání notifikací o změnách jako publikující AIS prostřednictvím EGSB.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Zpracování registrace notifikace ke změnám agendových údajů do jiných agend"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Zpracování výsledku vlastní reklamace cizích agendových údajů" id="typaszpracovanivlastnireklamaceagendoveudaje" profiles="id-5a96637beda94501b288c979796cd062">
      <documentation>Čtenářská agenda si  ve svém agendovém informačním systému vede evidenci jí vznesených  reklamací jak u základních registrů, tak u údajích v ostatních agendách. Účelem této evidence je mít přehled o vznesených reklamacích a také o jejich výsledcích. A schopnost na základě dalších služeb a změn údajů ze strany základních registrů a publikujících informačních systémů zpracovávat změny údajů, jež vyplynuly z reklamací. Příslušný čtenářský AIS zapisuje do této evidence a prostřednictvím seznamu reklamací pak zpracovává jejich stavy a případně upravuje údaje nebo příznak o zpochybnění.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Zpracování výsledku vlastní reklamace cizích agendových údajů"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Ztotožnění fyzické osoby z Registru obyvatel" id="typasztotoznenirob" profiles="id-5a96637beda94501b288c979796cd062">
      <documentation>OVM si pro účely povinného využívání referenčních údajů a agendových údajů ztotožní fyzickou osobu, o níž vede údaje. Základní trojice ztotožňovacích údajů jsou popsány v dokumentaci k ZR, výsledkem je jednoznačné určení konkrétní jedné fyzické osoby podle její identity v Registru obyvatel. Osobě je pro danou agendu a AIS přiděleno AIFO a pod tímto AIFO je jako pod hlavním technickým identifikátorem vedena u OVM ve všech AISech v dané agendě. Výsledkem je tedy přidělené AIFO a možnost využívat služby ISZR a EGSB pro danou fyzickou osobu. Platí, že pokud vede údaje o též osobě ve více agendách, provádí ztotožnění pro každou z těchto agend.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Ztotožnění fyzické osoby z Registru obyvatel"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Ztotožnění právnického subjektu z Registru osob" id="typasztotozneniros" profiles="id-5a96637beda94501b288c979796cd062">
      <documentation>OVM si v rámci své působnosti také ztotožňuje právnické subjekty, a to z Registru osob. Identifikátorem subjektu je IČ a v případě dělení na místní jednotky také IČP (pobočky). Referenční údaje z ROS jsou sice veřejné, nicméně stále platí povinnost OVM využívat je způsobem, jakým se využijí referenční údaje ze ZR, tedy využíváním údajů prostřednictvím ISZR. Obdobné to pak je i u potřeby ztotožnění fyzických osob z Registru obyvatel v případě jednatelů či dalších osob jednajících jménem právnického subjektu.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Ztotožnění právnického subjektu z Registru osob"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Aktualizace údajů o fyzické osobě z Registru obyvatel podle notifikace o změně" id="typasaktualizacerobnotifikace">
      <documentation>Po přihlášení notifikace osoby podle jejího AIFO a zaslané notifikaci o změně některých údajů pro dané AIFO se provede aktualizace. Notifikace neobsahuje změny údajů, ale jen AIFO, u kterého došlo ke změně. Je nutno si tedy přes ISZR aktualizovat údaje, které eviduji a uvnitř AISu si udělat jejich porovnání a zapsat ty změněné.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Aktualizace údajů o fyzické osobě z Registru obyvatel podle notifikace o změně"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Poskytnutí vlastních agendových údajů jinému AIS při změně" id="typasposkytnutiudajujinamzmena">
      <documentation>Na základě zaregistrované notifikace o změnách agendových údajů se prostřednictvím eGSB na aktivní žádost o aktualizaci agendových údajů poskytne určená sada agendových údajů. Technicky je shodné se službou poskytnutí údajů na vyžádání.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Poskytnutí vlastních agendových údajů jinému AIS při změně"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Reklamace neexistujícího agendového údaje v jiné agendě" id="typasreklamaceudajeneexistujeodjinut">
      <documentation>V případě potřeby agendového údaje v jiné agendě pro výkon naší působnosti, dozvíme-li se o tom, že daný agendový údaj neexistuje, nebo není publikujícím AISem veden, vzneseme reklamaci vůči neexistenci takového údaje. Prostřednictvím eGSB a publikujícího AISu vzneseme reklamaci vůči editoru chybějícího údaje.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Reklamace neexistujícího agendového údaje v jiné agendě"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Záznam o odkazování klienta na Zápis o skutečnosti z RPP" id="typaszaznamodkazovanizapisrpp">
      <documentation>V případě, že klient uplatní svoje právo podle zákona 12/2000, zapíšeme záznam o tom, že se odkázal na zapsanou skutečnost v Registru práv a povinností. Na základě toho pak získáme z RPP příslušné údaje.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Záznam o odkazování klienta na Zápis o skutečnosti z RPP"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Dotaz na existenci agendových údajů k subjektu v jiné agendě" id="typasdotazexistenceagendoveudajeksubjektu">
      <documentation>AIS se prostřednictvím služeb eGSB zeptá publikujícího AISu, zda k danému subjektu existují požadované agendové údaje. Identifikací subjektu je u fyzické osoby AIFO, u právnické osoby IČ a u fyzické osoby zastupující právnickou osobu také AIFO. Na základě odpovědi, že agendový údaj existuje, jej AIS vyžádá a získá.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Dotaz na existenci agendových údajů k subjektu v jiné agendě"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Zpracování výsledku vlastní reklamace cizích agendových údajů" id="typaszpracovanivlastnireklamaceagendoveudaje">
      <documentation>Čtenářská agenda si  ve svém agendovém informačním systému vede evidenci jí vznesených  reklamací jak u základních registrů, tak u údajích v ostatních agendách. Účelem této evidence je mít přehled o vznesených reklamacích a také o jejich výsledcích. A schopnost na základě dalších služeb a změn údajů ze strany základních registrů a publikujících informačních systémů zpracovávat změny údajů, jež vyplynuly z reklamací. Příslušný čtenářský AIS zapisuje do této evidence a prostřednictvím seznamu reklamací pak zpracovává jejich stavy a případně upravuje údaje nebo příznak o zpochybnění.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Zpracování výsledku vlastní reklamace cizích agendových údajů"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Přihlášení k notifikaci změny údajů fyzické osoby z Registru obyvatel" id="typasprihlaseninotifikacerob">
      <documentation>U dlouhodobě evidovaných fyzických osob zajistíme aktuálnost referenčních údajů tak, že se prostřednictvím ISZR zaregistrujeme pro notifikování o každé změně námi využívaných referenčních údajů. Identifikátorem je AIFO.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Přihlášení k notifikaci změny údajů fyzické osoby z Registru obyvatel"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Reklamace údajů o fyzické osobě v Registru obyvatel" id="typasreklamacerob">
      <documentation>Vznikne-li oprávněná pochybnost o správnosti a platnosti údajů vedených o fyzické osobě v Registru obyvatel, vzneseme prostřednictvím ISZR a příslušného základního registru reklamaci vůči editoru údajů.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Reklamace údajů o fyzické osobě v Registru obyvatel"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Poskytnutí informace, že agendový údaj neexistuje" id="typasposkytnutiinfoneexistenceudajejinam">
      <documentation>Po dotazu jiného AIS na existenci agendového údaje, pokud se zjistí, že v našem AIS takový údaj neexistuje a není evidován, se čtenářskému AIS sdělí, že takový údaj neexistuje. Obdobně se neexistence údaje sdělí v případě, že čtenářský AIS realizuje vyžádání nebo získání našeho agendového údaje. Pozor, neexistence údaje je odlišná od situace, kdy je údaj prázdný, nebo není aktuální.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Poskytnutí informace, že agendový údaj neexistuje"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Získání výsledku vlastní reklamace" id="typasziskanivysledkuvlastnireklamace">
      <documentation>U námi vznesených reklamací buď zpracováním aktualizace změny údajů, nebo informací o výsledku reklamace předané prostřednictvím ISZR, získáme faktický stav vyřízení reklamace. Pokud je výsledkem změna údajů, postupujeme podle aktualizace údajů, pokud je výsledek jiný, přestaneme považovat reklamovaný údaj za zpochybněný.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Získání výsledku vlastní reklamace"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Zpracování notifikací o změnách údajů právnického subjektu z Registru osob" id="typaszpracovaninotifikaceros">
      <documentation>Po zaslané notifikaci, respektive, vyzvednuté notifikaci změn ze základního registru si u subjektů, u nichž to dává smysl, provedeme aktualizaci jejich údajů a následné porovnání a úpravy v našem datovém fondu.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Zpracování notifikací o změnách údajů právnického subjektu z Registru osob"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Poskytnutí vlastních agendových údajů jinému AIS na vyžádání" id="typasposkytnutiudajujinamvyzadani">
      <documentation>Prostřednictvím eGSB se poskytnou požadované agendové údaje, pokud o ně čtenářský AIS jednorázově požádá. Údaje se poskytují ve struktuře definované podle Údajů o údajích v agendě.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Poskytnutí vlastních agendových údajů jinému AIS na vyžádání"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Přihlášení k notifikaci změny údajů právnického subjektu z Registru osob" id="typasprihlaseninotifikaceros">
      <documentation>U dlouhodobě evidovaných právnických subjektů zajistíme aktuálnost referenčních údajů tak, že se prostřednictvím ISZR zaregistrujeme pro notifikování o každé změně námi využívaných referenčních údajů. Identifikátorem je IČ.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Přihlášení k notifikaci změny údajů právnického subjektu z Registru osob"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Zpracování notifikací o změnách údajů z Registru obyvatel" id="typaszpracovaninotifikacerob">
      <documentation>Po zaslané notifikaci, respektive, vyzvednuté notifikaci změn ze základního registru si u subjektů, u nichž to dává smysl, provedeme aktualizaci jejich údajů a následné porovnání a úpravy v našem datovém fondu.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Zpracování notifikací o změnách údajů z Registru obyvatel"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Poskytnutí vlastních agendových údajů jinému AIS proaktivně" id="typasposkytnutiudajujinamproaktivne">
      <documentation>Prostřednictvím eGSB se proaktivně zašle ticket s informací o dostupnosti agendových údajů, nebo se sadou poskytovaných agendových údajů čtenářskému AIS. Je alternativou služby poskytnutí údajů na vyžádání, kdy iniciátorem takového poskytnutí jsme my. Pozor, nezaměňovat s poskytnutím notifikace o změně údajů.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Poskytnutí vlastních agendových údajů jinému AIS proaktivně"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Reklamace neexistujících údajů o fyzické osobě v Registru obyvatel" id="typasreklamacerobneexistujiciudaje">
      <documentation>Zjistíme-li při využívání referenčních údajů z Registru obyvatel, že některý referenční údaj chybí, vzneseme reklamaci na neexistenci údaje prostřednictvím ISZR a příslušného základního registru.</documentation>
      <property key="Stereotype" value="Typizovaná aplikační služba IS"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Typizovaná aplikační služba IS Reklamace neexistujících údajů o fyzické osobě v Registru obyvatel"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-61e0b3902ef842b683eb9783d15ad857" type="technology"/>
  <folder name="Motivation" id="id-6ad00de37fe34042bd3e68b1a2219299" type="motivation">
    <folder name="Objekty IKČR" id="id-d6b8040b970346639ddc62e11d5ea7a0">
      <element xsi:type="archimate:Principle" name="Architektonický princip P1: Standardně digitalizované (Digital by default)" id="ikcrP01" profiles="id-15658d97819f4ababa6b3e9048070d4c">
        <documentation>Orgány veřejné správy mají poskytovat služby primárně digitálně a samoobslužně, zároveň musí udržovat otevřené i další kanály pro ty, kteří nemohou buď z vlastního rozhodnutí, lidských nebo technických důvodů využívat digitální služby. Kromě toho veřejné služby mají být poskytovány i asistovaně, prostřednictvím jednotného kontaktního místa a prostřednictvím různých obslužných kanálů. Klient veřejné správy musí však mít právo zvolit si pro komunikaci s veřejnou správou i tradiční obslužné přepážky jednotlivých OVM (opt – out princip).</documentation>
        <property key="Určuje" value="IKČR"/>
        <property key="Status" value="Adopted"/>
        <property key="FQname" value="Objekt IKČR Architektonický princip P1: Standardně digitalizované (Digital by default)"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="User notes"/>
        <property key="User notes"/>
        <property key="Packages" value="objektyikcr, sdkdmmotivace, sfdicilovykonceptis"/>
        <property key="Packages"/>
        <property key="FQname" value="Objekt IKČR Architektonický princip P1: Standardně digitalizované (Digital by default)"/>
        <property key="Status" value="Updated"/>
        <property key="Určuje" value="IKČR"/>
        <property key="Stereotype" value="Objekt IKČR"/>
      </element>
      <element xsi:type="archimate:Principle" name="Architektonický princip P2: Pouze jednou (Once only)" id="ikcrP02" profiles="id-15658d97819f4ababa6b3e9048070d4c">
        <documentation>Orgány veřejné správy musí zaručit, že občané a podniky poskytují stejné informace celé veřejné správě pouze jednou. Orgány veřejné správy využívají při výkonu působnosti tyto sdílené údaje opakovaně, přičemž musí dodržovat pravidla ochrany údajů.</documentation>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="FQname" value="Objekt IKČR Architektonický princip P2: Pouze jednou (Once only)"/>
        <property key="Status" value="Adopted"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="Určuje" value="IKČR"/>
        <property key="FQname" value="Objekt IKČR Architektonický princip P2: Pouze jednou (Once only)"/>
        <property key="Určuje" value="IKČR"/>
        <property key="Packages" value="objektyikcr, sdkdmmotivace, sfdicilovykonceptis"/>
        <property key="User notes"/>
        <property key="User notes"/>
        <property key="Status" value="Updated"/>
        <property key="Packages"/>
      </element>
      <element xsi:type="archimate:Principle" name="Architektonický princip P3: Podpora začlenění a přístupnost (Inclusiveness and Accessibility)" id="ikcrP03" profiles="id-15658d97819f4ababa6b3e9048070d4c">
        <documentation>Orgány veřejné správy musí digitální veřejné služby koncipovat tak, aby standardně podporovaly začlenění a vyhovovaly z pohledu funkcí, UX/UI designu a způsobem ovládání specifickým potřebám nejrůznějších skupin klientů z pohledu jejich věku, schopností nebo lidem s různými formami zdravotního postižení.</documentation>
        <property key="Určuje" value="IKČR"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="Status" value="Adopted"/>
        <property key="Určuje" value="IKČR"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="FQname" value="Objekt IKČR Architektonický princip P3: Podpora začlenění a přístupnost (Inclusiveness and Accessibility)"/>
        <property key="Packages"/>
        <property key="Packages"/>
        <property key="Status" value="Updated"/>
        <property key="User notes"/>
        <property key="FQname" value="Objekt IKČR Architektonický princip P3: Podpora začlenění a přístupnost (Inclusiveness and Accessibility)"/>
        <property key="User notes"/>
      </element>
      <element xsi:type="archimate:Principle" name="Architektonický princip P4: Otevřenost a transparentnost (Openness and Transparency)" id="ikcrP04" profiles="id-15658d97819f4ababa6b3e9048070d4c">
        <documentation>Orgány veřejné správy mezi sebou mají sdílet informace a data a musí občanům a podnikům umožnit přístup ke kontrole vlastních údajů a možné opravě. Musí uživatelům umožnit sledování správních procesů, které se jich týkají a musí do koncipování a poskytování služeb zapojit zúčastněné strany jak z komerční, akademické i občanské sféry a spolupracovat s nimi.</documentation>
        <property key="Status" value="Adopted"/>
        <property key="Status" value="Updated"/>
        <property key="Packages" value="Koncepcedzmhmp, objektyikcr, sdkdmmotivace, sfdicilovykonceptis"/>
        <property key="Packages" value="Koncepcedzmhmp"/>
        <property key="FQname" value="Objekt IKČR Architektonický princip P4: Otevřenost a transparentnost (Openness and Transparency)"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="User notes"/>
        <property key="Určuje" value="IKČR"/>
        <property key="User notes"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="FQname" value="Objekt IKČR Architektonický princip P4: Otevřenost a transparentnost (Openness and Transparency)"/>
        <property key="Určuje" value="IKČR"/>
      </element>
      <element xsi:type="archimate:Principle" name="Architektonický princip P5: Přeshraniční přístup jako standard (Cross border interoperability)" id="ikcrP05" profiles="id-15658d97819f4ababa6b3e9048070d4c">
        <documentation>Orgány veřejné správy mají relevantní digitální služby zpřístupnit napříč hranicemi a mají zabránit dalšímu růstu jejich fragmentace, a tím usnadnit mobilitu na jednotném trhu.</documentation>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="User notes"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="Packages"/>
        <property key="Určuje" value="IKČR"/>
        <property key="User notes"/>
        <property key="Packages"/>
        <property key="Status" value="Adopted"/>
        <property key="Status" value="Updated"/>
        <property key="FQname" value="Objekt IKČR Architektonický princip P5: Přeshraniční přístup jako standard (Cross border interoperability)"/>
        <property key="FQname" value="Objekt IKČR Architektonický princip P5: Přeshraniční přístup jako standard (Cross border interoperability)"/>
        <property key="Určuje" value="IKČR"/>
      </element>
      <element xsi:type="archimate:Principle" name="Architektonický princip P6: Interoperabilita jako standard (Interoperability by design)" id="ikcrP06" profiles="id-15658d97819f4ababa6b3e9048070d4c">
        <documentation>Veřejné služby mají být koncipovány tak, aby hladce fungovaly v rámci celého jednotného trhu a napříč různými organizačními jednotkami, a opíraly se o volný pohyb údajů a digitálních služeb v Evropské unii. Současně je nezbytné zajistit interoperabilitu veřejných služeb uvnitř veřejné správy ČR jako předpoklad odstranění místní příslušnosti a snížení omezujícího vlivu věcné příslušnosti služeb VS na jejich klienty.</documentation>
        <property key="Packages" value="objektyikcr, sdkdmmotivace, sfdicilovykonceptis"/>
        <property key="FQname" value="Objekt IKČR Architektonický princip P6: Interoperabilita jako standard (Interoperability by design)"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="Status" value="Adopted"/>
        <property key="FQname" value="Objekt IKČR Architektonický princip P6: Interoperabilita jako standard (Interoperability by design)"/>
        <property key="Určuje" value="IKČR"/>
        <property key="User notes"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="Status" value="Updated"/>
        <property key="Packages"/>
        <property key="User notes"/>
        <property key="Určuje" value="IKČR"/>
      </element>
      <element xsi:type="archimate:Principle" name="Architektonický princip P7: Důvěryhodnost a bezpečnost (Security &amp; Privacy by design)" id="ikcrP07" profiles="id-15658d97819f4ababa6b3e9048070d4c">
        <documentation>Všechny iniciativy mají přesahovat pouhé dodržování právního rámce pro ochranu osobních údajů, soukromí a bezpečnost informačních technologií a mají tyto prvky zahrnout již do fáze přípravy architektury výkonu služeb veřejné správy. Sloučení principů záměrné a standardní ochrany osobních údajů (Privacy by design a Privacy by default) a záměrné a standardní řízení bezpečnosti (Security by design). Omezení zpracování osobních údajů jeho účelem a minimalizace zpracovávaných osobních údajů je zásadní, stejně jako proaktivní a kontinuální řízení bezpečnosti na všech architektonických vrstvách.</documentation>
        <property key="User notes"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="User notes"/>
        <property key="FQname" value="Objekt IKČR Architektonický princip P7: Důvěryhodnost a bezpečnost (Security &amp; Privacy by design)"/>
        <property key="Packages" value="Koncepcedzmhmp, objektyikcr, sfdicilovykonceptis"/>
        <property key="FQname" value="Objekt IKČR Architektonický princip P7: Důvěryhodnost a bezpečnost (Security &amp; Privacy by design)"/>
        <property key="Určuje" value="IKČR"/>
        <property key="Packages" value="Koncepcedzmhmp, objektyikcr"/>
        <property key="Status" value="Adopted"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="Status" value="Updated"/>
        <property key="Určuje" value="IKČR"/>
      </element>
      <element xsi:type="archimate:Principle" name="Architektonický princip P8: Jeden stát (Whole-of-Government)" id="ikcrP08" profiles="id-15658d97819f4ababa6b3e9048070d4c">
        <documentation>Všechny iniciativy a veřejné služby mají být postaveny na společném přístupu ministerstev a dalších OVM k vytvoření a poskytování služeb veřejné správy a postupném odbourávání nežádoucího resortismu a tvorby duplicit. Zásadou je sdílení služeb, nezbytné infrastruktury a standardů pro realizaci jednotlivých služeb na všech úrovních veřejné správy i mezi nimi. Přestože je zodpovědnost za jednotlivé služby rozdělená, výsledek musí být z pohledu klienta jednotný.</documentation>
        <property key="Packages" value="sdkdmmotivace"/>
        <property key="FQname" value="Objekt IKČR Architektonický princip P8: Jeden stát (Whole-of-Government)"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="User notes"/>
        <property key="Status" value="Adopted"/>
        <property key="Určuje" value="IKČR"/>
        <property key="Určuje" value="IKČR"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="Packages"/>
        <property key="FQname" value="Objekt IKČR Architektonický princip P8: Jeden stát (Whole-of-Government)"/>
        <property key="Status" value="Updated"/>
        <property key="User notes"/>
      </element>
      <element xsi:type="archimate:Principle" name="Architektonický princip P9: Sdílené služby veřejné správy (Shared Services)" id="ikcrP09" profiles="id-15658d97819f4ababa6b3e9048070d4c">
        <documentation>Budování a využívání sdílených služeb ve veřejné správě je jednou ze základních priorit eGovernmentu. Pokud bude výsledkem nové či upravované legislativy služba veřejné správy, má být koncipována jako služba sdílená nebo s využitím existujících sdílených služeb.</documentation>
        <property key="Packages" value="objektyikcr, sdkdmmotivace, sfdicilovykonceptis"/>
        <property key="Určuje" value="IKČR"/>
        <property key="Packages"/>
        <property key="Určuje" value="IKČR"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="FQname" value="Objekt IKČR Architektonický princip P9: Sdílené služby veřejné správy (Shared Services)"/>
        <property key="Status" value="Adopted"/>
        <property key="User notes"/>
        <property key="FQname" value="Objekt IKČR Architektonický princip P9: Sdílené služby veřejné správy (Shared Services)"/>
        <property key="Status" value="Updated"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="User notes"/>
      </element>
      <element xsi:type="archimate:Principle" name="Architektonický princip P10: Připravenost na změny (Flexibility)" id="ikcrP10" profiles="id-15658d97819f4ababa6b3e9048070d4c">
        <documentation>Procesy poskytování služeb veřejné správy i IT řešení jejich podpory musí být navrhovány tak, aby umožňovaly efektivně implementovat rozhodnutí reagující pružně na změnu zákonných parametrů služeb, změnu technologie, změnu dodavatele a další přicházející změny a potřeby.</documentation>
        <property key="FQname" value="Objekt IKČR Architektonický princip P10: Připravenost na změny (Flexibility)"/>
        <property key="Status" value="Adopted"/>
        <property key="Packages" value="Koncepcedzmhmp, objektyikcr, sfdicilovykonceptis"/>
        <property key="Status" value="Updated"/>
        <property key="User notes"/>
        <property key="Packages" value="Koncepcedzmhmp, objektyikcr"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="Určuje" value="IKČR"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="Určuje" value="IKČR"/>
        <property key="FQname" value="Objekt IKČR Architektonický princip P10: Připravenost na změny (Flexibility)"/>
        <property key="User notes"/>
      </element>
      <element xsi:type="archimate:Principle" name="Architektonický princip P11: eGovernment jako platforma (Embedded eGovernment)" id="ikcrP11" profiles="id-15658d97819f4ababa6b3e9048070d4c">
        <documentation>Digitalizované procesy, požadavky a služby veřejné správy, stejně jako technické prostředky pro jejich naplnění, musí být navrženy tak, aby umožnily klientům veřejné správy, především velkým organizacím, integrovat tyto služby do svých ICT řešení tak, aby pro ně bylo co nejsnazší dostát svým povinnostem vůči veřejné správě a dosáhnout svých práv.</documentation>
        <property key="User notes"/>
        <property key="Status" value="Adopted"/>
        <property key="FQname" value="Objekt IKČR Architektonický princip P11: eGovernment jako platforma (Embedded eGovernment)"/>
        <property key="FQname" value="Objekt IKČR Architektonický princip P11: eGovernment jako platforma (Embedded eGovernment)"/>
