    <element xsi:type="archimate:Principle" name="Konceptuální datové modely jako základ datové architektury" id="Spravdatp01" profiles="id-0855f775c5c14958b5424294a7376493">
      <documentation>Svoji datovou architekturu v úřadu určujeme jednotlivými konceptuálními datovými modely jako logickými datovými modely pro určitou agendu, oblast či činnosti. Buď jde o národně závazné KDM agend, nebo o sdílené KDM pro oblasti nebo o naše KDM v rámci konceptuálních modelů pro jednotlivé evidence a činnosti v úřadu.</documentation>
      <property key="Stereotype" value="Architektonický princip"/>
      <property key="Určuje"/>
      <property key="Packages" value="sdkdmmotivace, spravnaspravadatprincipyazasadyvuradu"/>
      <property key="FQname" value="Architektonický princip Konceptuální datové modely jako základ datové architektury"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:Principle" name="Adopce konceptuálních datových modelů agend národní úrovně" id="Spravdatp02" profiles="id-0855f775c5c14958b5424294a7376493">
      <documentation>Pro agendy a evidence, pro které existuje konceptuální datový model agendy na národní úrovni, vždy přebíráme tento model a maximálně jej doplňujeme o vlastní specifika. Model přebíráme z Registru práv a povinností či z informačního systému pro KDM spravovaného DIA.</documentation>
      <property key="Stereotype" value="Architektonický princip"/>
      <property key="Určuje"/>
      <property key="Packages" value="sdkdmmotivace, spravnaspravadatprincipyazasadyvuradu"/>
      <property key="FQname" value="Architektonický princip Adopce konceptuálních datových modelů agend národní úrovně"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:Principle" name="Datová architektura aplikace navázaná na konceptuální datový model" id="Spravdatp03" profiles="id-0855f775c5c14958b5424294a7376493">
      <documentation>Pokud aplikace pracuje s daty, pro které existuje konceptuální datový model, tak musí být z datové architektury a z architektonické dokumentace jasné, jak jsou data fyzicky vedena v databázi.</documentation>
      <property key="Stereotype" value="Architektonický princip"/>
      <property key="Určuje"/>
      <property key="Packages" value="sdkdmmotivace, spravnaspravadatprincipyazasadyvuradu"/>
      <property key="FQname" value="Architektonický princip Datová architektura aplikace navázaná na konceptuální datový model"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:Principle" name="Jednotná správa konceptuálních modelů" id="Spravdatz01" profiles="id-06f9bd805fd141d491a4235a6f32aefe">
      <documentation>V úřadu existuje nástroj pro správu konceptuálních modelů, který umí přebírat jak konceptuální modely z národní databáze, tak vytvářet potřebné konceptuální modely, jež nejsou dosud k dispozici.</documentation>
      <property key="Stereotype" value="Zásada"/>
      <property key="Určuje"/>
      <property key="Packages" value="sdkdmmotivace, spravnaspravadatprincipyazasadyvuradu"/>
      <property key="FQname" value="Zásada Jednotná správa konceptuálních modelů"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:Principle" name="Sdílení vlastních sémantických modelů a konceptuálních modelů pro zbytek veřejné správy" id="Spravdatz02" profiles="id-06f9bd805fd141d491a4235a6f32aefe">
      <documentation>Pokud úřad zjistí, že k určité oblasti neexistuje konceptuální model a takový úřad si jej sám vytvoří, poskytne jej pak prostřednictvím DIA zbytku veřejné správy k dalšímu využití.</documentation>
      <property key="Stereotype" value="Zásada"/>
      <property key="Určuje"/>
      <property key="Packages" value="sdkdmmotivace, spravnaspravadatprincipyazasadyvuradu"/>
      <property key="FQname" value="Zásada Sdílení vlastních sémantických modelů a konceptuálních modelů pro zbytek veřejné správy"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:Principle" name="Data mají jeden autoritativní systém pro správu a evidenci" id="Spravdatz03" profiles="id-06f9bd805fd141d491a4235a6f32aefe">
      <documentation>Ta samá data se nespravují vícekrát. Je-li potřeba mít stejná data v různých systémech pro různé účely, děje se tak buď odkazem, nebo synchronizací, nikoliv samostatnou správou.</documentation>
      <property key="Stereotype" value="Zásada"/>
      <property key="Určuje"/>
      <property key="Packages" value="sdkdmmotivace, spravnaspravadatprincipyazasadyvuradu"/>
      <property key="FQname" value="Zásada Data mají jeden autoritativní systém pro správu a evidenci"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:Principle" name="Pro každá data musí být známy podrobnosti o jejich správě a důvěryhodnosti" id="Spravdatz04" profiles="id-06f9bd805fd141d491a4235a6f32aefe">
      <documentation>U každých dat musí být jasný jejich zdroj, vznik, editor, způsob pořízení a změny a historie dat.</documentation>
      <property key="Stereotype" value="Zásada"/>
      <property key="Určuje"/>
      <property key="Packages" value="sdkdmmotivace, spravnaspravadatprincipyazasadyvuradu"/>
      <property key="FQname" value="Zásada Pro každá data musí být známy podrobnosti o jejich správě a důvěryhodnosti"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:Principle" name="Řízení správy údajů dle jejich klasifikace" id="Spravdatz05" profiles="id-06f9bd805fd141d491a4235a6f32aefe">
      <documentation>V úřadu je zavedena klasifikace údajů a podle ní se k údajům chováme.</documentation>
      <property key="Stereotype" value="Zásada"/>
      <property key="Určuje"/>
      <property key="Packages" value="sdkdmmotivace, spravnaspravadatprincipyazasadyvuradu"/>
      <property key="FQname" value="Zásada Řízení správy údajů dle jejich klasifikace"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:Principle" name="Stanovení zodpovědnosti za data" id="Spravdatz06" profiles="id-06f9bd805fd141d491a4235a6f32aefe">
      <documentation>U každé skupiny údajů nebo údaje musí být jasné, kdo za něj zodpovídá, ať už přímo jako editor údaje, nebo ten, kdo nesprávný údaj jiného editora má reklamovat.</documentation>
      <property key="Stereotype" value="Zásada"/>
      <property key="Určuje"/>
      <property key="Packages" value="sdkdmmotivace, spravnaspravadatprincipyazasadyvuradu"/>
      <property key="FQname" value="Zásada Stanovení zodpovědnosti za data"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:Principle" name="Dodavatelé dodávají i datovou architekturu aplikací a evidencí" id="Spravdatz07" profiles="id-06f9bd805fd141d491a4235a6f32aefe">
      <documentation>Je nutné po dodavateli, a to v rámci dokumentace, vyžadovat datovou architekturu aplikací a evidencí, tedy, je důležité vědět, jak se samotná data v aplikacích a evidencích vedou, spravujou a jaké jsou mezi nimi vazby. Datová architektura je vázaná na konceptuální model.</documentation>
      <property key="Stereotype" value="Zásada"/>
      <property key="Určuje"/>
      <property key="Packages" value="sdkdmmotivace, spravnaspravadatprincipyazasadyvuradu"/>
      <property key="FQname" value="Zásada Dodavatelé dodávají i datovou architekturu aplikací a evidencí"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:Goal" name="Řádná adopce architektonických principů a zásad řízení z Informační koncepce Čr" id="itciladopcepzikcr" profiles="id-28661a565f7541198b13abc70b07e508">
      <documentation>Úřady mající vlastní IK musí a ostatní by měly zvážit adopci rozumných cílů a principu a zásad z IKČR. Dle mechanismu nevymýšlet již jednou vymyšlené se dají objekty IKČR velice hezky vzít za základ vlastní úrovně.</documentation>
      <property key="Stereotype" value="Cíl rozvoje"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Cíl rozvoje Řádná adopce architektonických principů a zásad řízení z Informační koncepce Čr"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:Goal" name="Stanovení cílů a realizace projektů pro naplnění národních cílů z IKČR￼" id="itcilnasecilecileikcr" profiles="id-28661a565f7541198b13abc70b07e508">
      <documentation>Nestačí pouze správně adoptovat cíle a principy Informační koncepce ČR, ale také přizpůsobit naše aktivity naplňování v praxi. Chceme detailně rozebrat stav našich povinností a našich systémů a jejich integrace a chceme připravovat takové projekty, které budou v souladu s IKČR a budou realizovat její cíle v našem prostředí a s našimi specifiky.</documentation>
      <property key="Stereotype" value="Cíl rozvoje"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Cíl rozvoje Stanovení cílů a realizace projektů pro naplnění národních cílů z IKČR￼"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:Goal" name="Cíl rozvoje IT" id="metamodelitcil" profiles="id-28661a565f7541198b13abc70b07e508">
      <documentation>Cíl klíčový pro efektivitu nákladů a přínosů ICT prostředků a správný rozvoj ICT v organizaci.</documentation>
      <property key="Stereotype" value="Cíl rozvoje"/>
      <property key="Určuje"/>
