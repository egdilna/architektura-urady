        <property key="Určuje" value="IKČR"/>
      </element>
      <element xsi:type="archimate:Goal" name="Dílčí cíl 5.5: eGovernment cloud" id="ikcrc505" profiles="id-c769109e8d4b45739cc6a32f73d4c50e">
        <documentation>Cíl zahrnuje vytvoření eGovernment Cloud (eGC), který se skládá z části státní a komerční, pro potřeby veřejné správy ČR – online služeb na úrovních IaaS (Infrastructure as a Service), PaaS (Platform as a Service) a SaaS (Software as a Service). V komerční části eGC jsou poskytovány dynamickým nákupním systémem nabízené služby (Iaas, PaaS, SaaS) komerčních poskytovatelů. Státní část eGC se soustředí na budování sdílených platforem (PaaS) a infrastruktury (IaaS) pro jedinečné a centrálně poskytované zákony definované služby ISVS.</documentation>
        <property key="FQname" value="Objekt IKČR Dílčí cíl 5.5: eGovernment cloud"/>
        <property key="Packages"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="Packages"/>
        <property key="User notes"/>
        <property key="Určuje" value="IKČR"/>
