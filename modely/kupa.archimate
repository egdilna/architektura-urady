    </element>
    <element xsi:type="archimate:CompositionRelationship" name="obsahuje" id="groupingikcrovmitpzgroupingikcrarchprincipy" profiles="id-39c52d83ede04a5694909a5f5b01a076" source="groupingikcrovmitpz" target="groupingikcrarchprincipy">
      <documentation>Úřad si vždy povinně adoptuje veškeré architektonické principy z IKČR. Jeho principy se tedy sestavují z adoptovaných národních a z dalších jeho vlastních. Narozdíl od cílů si adoptuje povinně všechny.</documentation>
      <property key="Factoring" value="Strategie a řízení"/>
      <property key="FQname" value="Skupina Principy a zásady úřadu obsahuje Skupina Národní  architektonické principy"/>
      <property key="Statement" value="Principy a zásady úřadu obsahuje Národní  architektonické principy"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
      <property key="In diagrams" value="prehledikovsadopceikcr"/>
      <property key="Packages"/>
