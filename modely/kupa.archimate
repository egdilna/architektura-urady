      <element xsi:type="archimate:Principle" name="Zásada řízení ICT Z12: Řízení kapacit zdrojů" id="ikcrZ12" profiles="id-15658d97819f4ababa6b3e9048070d4c">
        <documentation>OVS průběžně připravuje zajištění dostatečného množství a kvality interních kapacit vlastníků procesů/agend, garantů/správců systémů, projektových manažerů a architektů, odpovídající jejich předpokládanému uvolnění do programů a projektů realizace transformačních změn.</documentation>
        <property key="FQname" value="Objekt IKČR Zásada řízení ICT Z12: Řízení kapacit zdrojů"/>
        <property key="FQname" value="Objekt IKČR Zásada řízení ICT Z12: Řízení kapacit zdrojů"/>
        <property key="Status" value="Adopted"/>
        <property key="Určuje" value="IKČR"/>
