    <element xsi:type="archimate:Goal" name="Specifický cíl 4.2 Zajištění řízeného přístupu k datům veřejné správy" id="stratsprdco420" profiles="id-938b3962368b4aceaf3f601aeb264c5f">
      <documentation>Tento cíl směřuje k tomu, aby veřejná správa zajistila oprávněnému žadateli při splnění zákonem daných podmínek (prokázané legitimní důvody využití dat apod.) tzv. řízený přístup k datům v souladu s právními předpisy upravujícími tuto oblast (připravovaný zákon o správě dat veřejného sektoru, který je implementací nařízení o evropské správě dat - Data Governance Act).</documentation>
      <property key="Stereotype" value="Objekt strategie"/>
      <property key="Určuje" value="Strategie správy dat VS"/>
      <property key="Packages" value="strategiespravydatcr"/>
      <property key="FQname" value="Objekt strategie Specifický cíl 4.2 Zajištění řízeného přístupu k datům veřejné správy"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
