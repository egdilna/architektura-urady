      <element xsi:type="archimate:Principle" name="Zásada řízení ICT Z14: Vztah informatiky a legislativy" id="ikcrZ14" profiles="id-15658d97819f4ababa6b3e9048070d4c">
        <documentation>Návrhy možností informační podpory legislativních úprav je nutno vypracovávat společně s návrhy přijímání právních předpisů či jejich změn tak, aby se vzájemně ovlivňovaly směrem ke vzniku moderních a proveditelných ustanovení.</documentation>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="Status" value="Adopted"/>
        <property key="Packages" value="objektyikcr"/>
        <property key="Určuje" value="IKČR"/>
