      <property key="FQname" value="Orgán Vedení organizace"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Schvalování architektonických rozhodnutí" id="vparchadrn" profiles="id-1c1d6529e5f74e228e4cbc18a2c6b8ad">
      <documentation>Schvalování ADR podle kterého se pak realizují architektonické změny.</documentation>
      <property key="Stereotype" value="Vnitřní proces"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti, procesyarchrizeni"/>
      <property key="FQname" value="Vnitřní proces Schvalování architektonických rozhodnutí"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Tvorba návrhu architektonických rozhodnutí" id="vparchadrs" profiles="id-1c1d6529e5f74e228e4cbc18a2c6b8ad">
      <documentation>Pro ustavení řešení architektury se využívají architektonická rozhodnutí, která jsou reprezentována formálním dokumentem ADR, ten se vytvoří a po projednání se schválí.</documentation>
      <property key="Stereotype" value="Vnitřní proces"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti, procesyarchrizeni"/>
      <property key="FQname" value="Vnitřní proces Tvorba návrhu architektonických rozhodnutí"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Dohled nad realizací architektonických změn" id="vparchazdh" profiles="id-1c1d6529e5f74e228e4cbc18a2c6b8ad">
      <documentation>Při realizaci samotné architektonické změny a to zejména jejích architektonických, technických a procesních aspektů, musí existovat koordinace a dohled nad správnou realizací.</documentation>
      <property key="Stereotype" value="Vnitřní proces"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti, procesyarchrizeni"/>
      <property key="FQname" value="Vnitřní proces Dohled nad realizací architektonických změn"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Dohled nad dokumentací architektonických změn" id="vparchazdk" profiles="id-1c1d6529e5f74e228e4cbc18a2c6b8ad">
      <documentation>Architektonické změny se dokumentují na různých úrovních, ve fázi návrhu je to třeba ADR, ale musí se jejich výsledky zapsat do architektury řešení a také do dokumentací systémů a procesů.</documentation>
      <property key="Stereotype" value="Vnitřní proces"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti, procesyarchrizeni"/>
      <property key="FQname" value="Vnitřní proces Dohled nad dokumentací architektonických změn"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Návrhy architektonických změn" id="vparchazn" profiles="id-1c1d6529e5f74e228e4cbc18a2c6b8ad">
      <documentation>Architektonické změny podléhají procesu identifikace, návrhu řešení, jeho schvalování (i možná na národní úrovni prostřednictvím OHA) a následné realizace.</documentation>
      <property key="Stereotype" value="Vnitřní proces"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti, procesyarchrizeni"/>
      <property key="FQname" value="Vnitřní proces Návrhy architektonických změn"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Vnitřní edukace využití architektury" id="vparchedu" profiles="id-1c1d6529e5f74e228e4cbc18a2c6b8ad">
      <documentation>Architektura je sice také povinnost, ale správně vytvářená a realizovaná má obrovské přínosy. Jako u každé nepříliš známé věci je třeba v úřadu pečlivě vzdělávat také věcné gestory a odborné zaměstnance na architekturu a to zejména co jim přináší.</documentation>
      <property key="Stereotype" value="Vnitřní proces"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti, procesyarchrizeni"/>
      <property key="FQname" value="Vnitřní proces Vnitřní edukace využití architektury"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Generování výstupů z architektonických modelů" id="vparchgenvys" profiles="id-1c1d6529e5f74e228e4cbc18a2c6b8ad">
      <documentation>Důležité je zpracovávat architekturu nejen pro vnitřní potřeby architektury, ale umět i připravovat a distribuovat výstupy z architektury. Ať už se jedná o diagramy z architektonických modelů, nebo data či transformovaná data a nebo zpracovávat potřebné výstupy ze souvisejících znalostí.</documentation>
      <property key="Stereotype" value="Vnitřní proces"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti, procesyarchrizeni"/>
      <property key="FQname" value="Vnitřní proces Generování výstupů z architektonických modelů"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Správa Katalogu záměrů IK a dohled nad naplňováním záměrů" id="vparchikkz" profiles="id-1c1d6529e5f74e228e4cbc18a2c6b8ad">
      <documentation>Neoddělitelnou součástí informační koncepce jsou záměry realizující tuto koncepci, ty spravuje úřad v Katalogu záměrů IK. Ten se musí spravovat a zajistit řádné aktualizace informací o jednotlivých záměrech od jejich vlastníků. A také se musí zajistit sběr včasných podkladů pro vyhodnocení plnění záměrů pro vyhodnocení IK a projednání změn a nových záměrů.</documentation>
      <property key="Stereotype" value="Vnitřní proces"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti, procesyarchrizeni"/>
      <property key="FQname" value="Vnitřní proces Správa Katalogu záměrů IK a dohled nad naplňováním záměrů"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Příprava a koordinace tvorby IK úřadu a jejích aktualizací" id="vparchikt" profiles="id-1c1d6529e5f74e228e4cbc18a2c6b8ad">
      <documentation>Ať už je IK úřady vytvářena interními zdroji a nebo z nějakého důvodu externí dodávkou, musí to být velice pečlivě koordinováno ze strany úřadu. To platí pochopitelně i pro aktualizace IK.</documentation>
      <property key="Stereotype" value="Vnitřní proces"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti, procesyarchrizeni"/>
      <property key="FQname" value="Vnitřní proces Příprava a koordinace tvorby IK úřadu a jejích aktualizací"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Sledování plnění IK úřadu a vyhodnocování plnění" id="vparchikv" profiles="id-1c1d6529e5f74e228e4cbc18a2c6b8ad">
      <documentation>Jednou z povinností úřadu je kromě vydávání a aktualizování své informační koncepce, realizovat její plnění a také pravidelně plnění vyhodnocovat. Také tato činnost musí být řádně zajišťována.</documentation>
      <property key="Stereotype" value="Vnitřní proces"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti, procesyarchrizeni"/>
      <property key="FQname" value="Vnitřní proces Sledování plnění IK úřadu a vyhodnocování plnění"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Kontrola procesů architektury a kvality architektury" id="vparchkonta" profiles="id-1c1d6529e5f74e228e4cbc18a2c6b8ad">
      <documentation>Stanovené zodpovědnosti v rámci řízení architektury je třeba také kontrolovat a dohlížet na ně. To se týká i kvality vstupů pro architekturu a využívání výstupů v praxi.</documentation>
      <property key="Stereotype" value="Vnitřní proces"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti, procesyarchrizeni"/>
      <property key="FQname" value="Vnitřní proces Kontrola procesů architektury a kvality architektury"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Sledování a koordinace vyhodnocování plnění EG" id="vparchplegp" profiles="id-1c1d6529e5f74e228e4cbc18a2c6b8ad">
      <documentation>Úřad si může vytvořit assessment povinností EG a nebo sledovat naplnění EG povinností jinou srovnatelnou metodou. Za plnění a zhodnocení vůči konkrétním povinnostem jsou zodpovědní jednotliví věcní gestoři z dané oblasti, ale nad nimi musí být přes celý úřad koordinace udržování znalostí o EG povinnostech a potřebných krocích. Přestože to není přímo součást architektury, jedná se o jednu z klíčových oblastí architektury a koordinace a dohled musí být úzce propojen s řízením architektury a využíváním architektonických znalostí.</documentation>
      <property key="Stereotype" value="Vnitřní proces"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti, procesyarchrizeni"/>
      <property key="FQname" value="Vnitřní proces Sledování a koordinace vyhodnocování plnění EG"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Správa požadavků na architekturu a sledování jejich plnění" id="vparchpoz" profiles="id-1c1d6529e5f74e228e4cbc18a2c6b8ad">
      <documentation>Architektura se nevytváří jen proto, abychom si splnili povinnost a udělali čárku, ale má se opravdu používat a podle ní se má rozhodovat o fungování úřadu. Proto je nezbytné sbírat požadavky odborných útvarů a vedení a rozvoj architektury a jejich znalostí a tyto požadavky vyhodnocovat a naplňovat, aby architektura měla v úřadu opravdový přínos.</documentation>
      <property key="Stereotype" value="Vnitřní proces"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti, procesyarchrizeni"/>
      <property key="FQname" value="Vnitřní proces Správa požadavků na architekturu a sledování jejich plnění"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Tvorba předpisů pro modelování a aktualizace architektury" id="vparchpredp" profiles="id-1c1d6529e5f74e228e4cbc18a2c6b8ad">
      <documentation>V úřadu musí existovat interní předpisy podle kterých se postupuje při řízení, zpracovávání a aktualizacích architektury a to zejména v rámci architektonických modelů a tvorba a využití výstupů z architektury. Měly by zahrnovat i procesy řízení architektury a zodpovědnosti. Zejména řídící dokumenty k řízení procesů architektury musí být řádnými závaznými interními předpisy a musí se řádně projednat, schvalovat a kontrolovat jejich dodržování.</documentation>
      <property key="Stereotype" value="Vnitřní proces"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti, procesyarchrizeni"/>
      <property key="FQname" value="Vnitřní proces Tvorba předpisů pro modelování a aktualizace architektury"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Řízení a organizace Architektonického boardu" id="vparchrizab" profiles="id-1c1d6529e5f74e228e4cbc18a2c6b8ad">
      <documentation>Faktické řízení, správa a organizace správce boardu, včetně správy podkladů a zodpovědnosti vůči vedení.</documentation>
      <property key="Stereotype" value="Vnitřní proces"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti, procesyarchrizeni"/>
      <property key="FQname" value="Vnitřní proces Řízení a organizace Architektonického boardu"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Schvalování předpisů k řízení architektury" id="vparchsp" profiles="id-1c1d6529e5f74e228e4cbc18a2c6b8ad">
      <documentation>V rámci úřadu je třeba řádně stanovit procesy a zodpovědnosti rolí a týmů a pracovníků úřadu. Příslušné interní předpisy se zodpovědností se musí schvalovat jako závazné vnitřní předpisy.</documentation>
      <property key="Stereotype" value="Vnitřní proces"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti, procesyarchrizeni"/>
      <property key="FQname" value="Vnitřní proces Schvalování předpisů k řízení architektury"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Správa architektury" id="vparchspraar" profiles="id-1c1d6529e5f74e228e4cbc18a2c6b8ad">
      <documentation>Obsahová správa části architektury či architektonického modelu.</documentation>
      <property key="Stereotype" value="Vnitřní proces"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti, procesyarchrizeni"/>
      <property key="FQname" value="Vnitřní proces Správa architektury"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Správa architektonického repository" id="vparchsprarepo" profiles="id-1c1d6529e5f74e228e4cbc18a2c6b8ad">
      <documentation>Technická a obsahová zpráva architektonického repository, nejedná (nemusí se jednat) o technický chod databáze a serveru, jde o správu repository a jeho modelů a rozdělení a synchronizací.</documentation>
      <property key="Stereotype" value="Vnitřní proces"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti, procesyarchrizeni"/>
      <property key="FQname" value="Vnitřní proces Správa architektonického repository"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Odborný support v oblasti EG a digitalizace" id="vparchsup" profiles="id-1c1d6529e5f74e228e4cbc18a2c6b8ad">
      <documentation>Odborný support a poskytování odborných znalostí a odborné posuzování souladu s požadavky EG a rozvoje ICT pro všechny útvary úřadu.</documentation>
      <property key="Stereotype" value="Vnitřní proces"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti, procesyarchrizeni"/>
      <property key="FQname" value="Vnitřní proces Odborný support v oblasti EG a digitalizace"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Využívání znalostí a výstupů architektury" id="vparchvsv" profiles="id-1c1d6529e5f74e228e4cbc18a2c6b8ad">
      <documentation>Všichni zainteresovaní využívají architekturu a související znalosti pro svoji odbornou práci, na byznysové úrovni i na úrovni aplikační skladby apod.</documentation>
      <property key="Stereotype" value="Vnitřní proces"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti, procesyarchrizeni"/>
      <property key="FQname" value="Vnitřní proces Využívání znalostí a výstupů architektury"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Využívání architektonických znalostí pro procesní řízení " id="vparchvyproc" profiles="id-1c1d6529e5f74e228e4cbc18a2c6b8ad">
      <documentation>Znalosti a výstupy architektury úřadu mohou sloužit také jako podklady pro procesní řízení, kdy se na byznysové vrstvě modelují procesy a role či útvary vykonávající procesy a jejich vazby. Důležitá je i organizační struktura a vazby prvků z jednotlivých organizačních útvarů.</documentation>
      <property key="Stereotype" value="Vnitřní proces"/>
      <property key="Určuje"/>
      <property key="Packages" value="vykondulezitychcinnosti, procesyarchrizeni"/>
      <property key="FQname" value="Vnitřní proces Využívání architektonických znalostí pro procesní řízení "/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
