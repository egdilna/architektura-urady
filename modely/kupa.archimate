        <property key="Stereotype" value="Objekt IKČR"/>
      </element>
      <element xsi:type="archimate:Principle" name="Zásada řízení ICT Z07: Řízení zodpovědnosti za služby a systémy" id="ikcrZ07" profiles="id-15658d97819f4ababa6b3e9048070d4c">
        <documentation>Každá agenda/proces a jeho služba musí mít svého vlastníka (osobu), který určuje strukturu a způsob výkonu procesu/agendy a je odpovědný za zlepšování, napříč všemi podpůrnými IS.</documentation>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="Packages" value="sdkdmmotivace"/>
        <property key="User notes"/>
        <property key="User notes"/>
        <property key="Status" value="Adopted"/>
        <property key="Určuje" value="IKČR"/>
        <property key="Status" value="Adopted"/>
        <property key="FQname" value="Objekt IKČR Zásada řízení ICT Z07: Řízení zodpovědnosti za služby a systémy"/>
        <property key="Packages"/>
        <property key="FQname" value="Objekt IKČR Zásada řízení ICT Z07: Řízení zodpovědnosti za služby a systémy"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="Určuje" value="IKČR"/>
      </element>
      <element xsi:type="archimate:Principle" name="Zásada řízení ICT Z08: Řízení katalogu služeb" id="ikcrZ08" profiles="id-15658d97819f4ababa6b3e9048070d4c">
        <documentation>IT podpora OVS je řízena pomocí katalogu ICT služeb (převážně aplikačních, ale i technologických a infrastrukturních), kterými jsou podporovány procesy výkonu interních i externích služeb veřejné správy úřadu (tradičních i digitálních). Každý subjekt aktualizuje, publikuje a propaguje na internetu svůj katalog elektronických/digitálních služeb orientovaných na veřejnost a v intranetu obdobný katalog interních digitálních služeb.</documentation>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="Určuje" value="IKČR"/>
        <property key="Packages"/>
        <property key="User notes"/>
        <property key="FQname" value="Objekt IKČR Zásada řízení ICT Z08: Řízení katalogu služeb"/>
        <property key="Packages"/>
        <property key="Status" value="Adopted"/>
        <property key="User notes"/>
        <property key="FQname" value="Objekt IKČR Zásada řízení ICT Z08: Řízení katalogu služeb"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="Status" value="Adopted"/>
        <property key="Určuje" value="IKČR"/>
      </element>
      <element xsi:type="archimate:Principle" name="Zásada řízení ICT Z09: Udržení interních kompetencí" id="ikcrZ09" profiles="id-15658d97819f4ababa6b3e9048070d4c">
        <documentation>Pro všechny klíčové role řízení služeb eGovernmentu a řízení informatiky má OVS vytvořeny interní pozice. To je nezbytné pro udržení nezávislosti na dodavatelích, kontinuity a celostního pohledu, a zejména zodpovědnosti.</documentation>
        <property key="Status" value="Adopted"/>
        <property key="Packages" value="Koncepcedzmhmp, objektyikcr"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="Určuje" value="IKČR"/>
        <property key="FQname" value="Objekt IKČR Zásada řízení ICT Z09: Udržení interních kompetencí"/>
        <property key="Určuje" value="IKČR"/>
