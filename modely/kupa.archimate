    </element>
    <element xsi:type="archimate:Goal" name="Opatření 3.2.2 Prakticky podporovat aktivity úřadů směřující ke sdílení dat v prioritních oblastech" id="stratsprdco322" profiles="id-938b3962368b4aceaf3f601aeb264c5f">
