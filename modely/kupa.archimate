        <property key="User notes"/>
        <property key="Packages"/>
        <property key="User notes"/>
      </element>
      <element xsi:type="archimate:Principle" name="Zásada řízení ICT Z05: Řízení požadavků a změn" id="ikcrZ05" profiles="id-15658d97819f4ababa6b3e9048070d4c">
        <documentation>Vyhodnocování zpětné vazby, incidentů a požadavků na služby. Funkční proces řízení životního cyklu požadavků (na nové funkce, změny, opatření eliminující rizika) je z hlediska řízení informačních služeb a řízení změn architektury klíčový. Požadavky musí být průběžně evidovány, vyhodnocovány a zapracovány do aktualizací informační koncepce subjektu, do programových dokumentů, investičních záměrů, projektů nebo plánů drobných změn.</documentation>
        <property key="User notes"/>
        <property key="Určuje" value="IKČR"/>
        <property key="Packages" value="sdkdmmotivace"/>
        <property key="FQname" value="Objekt IKČR Zásada řízení ICT Z05: Řízení požadavků a změn"/>
        <property key="Status" value="Adopted"/>
        <property key="Status" value="Adopted"/>
        <property key="User notes"/>
        <property key="Určuje" value="IKČR"/>
        <property key="FQname" value="Objekt IKČR Zásada řízení ICT Z05: Řízení požadavků a změn"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="Packages"/>
      </element>
      <element xsi:type="archimate:Principle" name="Zásada řízení ICT Z06: Řízení výkonnosti a kvality" id="ikcrZ06" profiles="id-15658d97819f4ababa6b3e9048070d4c">
        <documentation>Vyhodnocování výkonnosti a kvality, minimálně principy měřitelnosti a zpětné vazby, budou zavedeny do všech procesů/postupů, stejně jako role, pozice manažera kvality (nezávislost výkonnosti a kvality IT na řízení rozvoje a provozu IT).</documentation>
        <property key="Packages"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="Packages"/>
