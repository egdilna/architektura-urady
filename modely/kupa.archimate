        <property key="Status" value="Updated"/>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="FQname" value="Objekt IKČR Dílčí cíl 5.5: eGovernment cloud"/>
        <property key="User notes"/>
        <property key="Určuje" value="IKČR"/>
      </element>
      <element xsi:type="archimate:Goal" name="Dílčí cíl 5.6: Národní ICT autorita" id="ikcrc506" profiles="id-c769109e8d4b45739cc6a32f73d4c50e">
        <documentation>Zajištění vydávání a aktualizace ICT standardů nezbytných pro zajištění rozvoje a bezchybného provozu jednotlivých ISVS. Zejména jde o standardy funkčních specifikací klíčových typových řešení, standardy ICT služeb a rozhraní. Pro řízení ICT jsou nutné zejména standardy jednotlivých metod řízení a standardy digitálních služeb a standardní typové SLA a OLA (dohody o úrovni služeb a provozu).</documentation>
        <property key="Stereotype" value="Objekt IKČR"/>
        <property key="Určuje" value="IKČR"/>
