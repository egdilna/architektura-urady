    </element>
    <element xsi:type="archimate:Stakeholder" name="Osoby se zdravotním postižením" id="ozpstakeholder" profiles="id-9500d054e6dc43dba921af65c48447f1">
      <documentation>OZP jako důležitý aktér interakce s veřejnou správou a jako příjemce určitých speciálních výhod a potřeb</documentation>
      <property key="Stereotype" value="Zainteresovaný subjekt"/>
      <property key="Určuje" value="ohlášení v RPP"/>
      <property key="Packages"/>
      <property key="FQname" value="Zainteresovaný subjekt Osoby se zdravotním postižením"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
    <element xsi:type="archimate:Driver" name="Změna úřednického myšlení státu" id="potrebazmenamysleni" profiles="id-7fd8fb0c76a54e01b8ddec2092605408">
      <documentation>Změna myšlení úřadů a úředníků je nezbytná. Bez zcela odlišného nového moderního přístupu k požadavkům klienta se to neobejde. Změna myšlení není jen formální rétorika, musí se změnit celkový přístup, a to zejména věcných gestorů a manažerů, jež navrhují služby. Ani dnes se to ale prakticky nedaří na vrcholové, ani střední manažerské úrovni.</documentation>
      <property key="Stereotype" value="Potřeba"/>
      <property key="Určuje"/>
      <property key="Packages"/>
      <property key="FQname" value="Potřeba Změna úřednického myšlení státu"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
