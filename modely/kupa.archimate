    <element xsi:type="archimate:Goal" name="Specifický cíl 3.2 Centrální podpora a koordinace sdílení dat" id="stratsprdco320" profiles="id-938b3962368b4aceaf3f601aeb264c5f">
      <documentation>Díky své nadresortní působnosti má DIA možnost identifikovat napříč úřady oblasti obsahující data, jejichž sdílení bude mít pro veřejnou správu jako celek největší přínos. Tento cíl směřuje k tomu, aby cíleným nasazením vlastních zdrojů na podporu aktivit v těchto oblastech pomohla urychlit celý proces poskytnutí dat na jedné straně (úřadem, který je spravuje) a jejich čerpání na straně druhé (jinými úřady).</documentation>
      <property key="Stereotype" value="Objekt strategie"/>
      <property key="Určuje" value="Strategie správy dat VS"/>
      <property key="Packages" value="strategiespravydatcr"/>
      <property key="FQname" value="Objekt strategie Specifický cíl 3.2 Centrální podpora a koordinace sdílení dat"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
