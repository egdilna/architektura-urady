    <element xsi:type="archimate:Goal" name="Specifický cíl 2.2 Konzultační a praktická podpora jednotlivých úřadů při zavádění správy dat" id="stratsprdco220" profiles="id-938b3962368b4aceaf3f601aeb264c5f">
      <documentation>Tento cíl směřuje k individuální cílené podpoře vybraných úřadů ze strany DIA (narozdíl od cíle předchozího, jehož výsledky jsou určeny všem plošně). DIA bude v rámci jeho naplňování dlouhodobě pracovat s jednotlivými úřady formou jejich konzultační podpory v oblasti správy dat a poskytne kapacitní podporu nezbytnou pro vytvoření popisu dat v nejprioritnějších oblastech.</documentation>
      <property key="Stereotype" value="Objekt strategie"/>
      <property key="Určuje" value="Strategie správy dat VS"/>
      <property key="Packages" value="strategiespravydatcr"/>
      <property key="FQname" value="Objekt strategie Specifický cíl 2.2 Konzultační a praktická podpora jednotlivých úřadů při zavádění správy dat"/>
      <property key="Status" value="Verified"/>
      <property key="User notes"/>
    </element>
