    <element xsi:type="archimate:CompositionRelationship" name="obsahuje" id="groupingikcrovmitcilemetamodelitcil" profiles="id-39c52d83ede04a5694909a5f5b01a076" source="groupingikcrovmitcile" target="metamodelitcil">
      <documentation>Kromě adoptovaných cílů z národní úrovně si v IK stanovujeme i vlastní cíle rozvoje ICT. Nemá cenu opisovat cíle národní, doplňujeme si svoje vlastní specifické.</documentation>
      <property key="Factoring" value="Strategie a řízení"/>
